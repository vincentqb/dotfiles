#!/usr/bin/env bash
# Drive ssa against a stub ssh, so the parts that only run when the network is
# broken can be tested while it works.
#
# The stub records its argv and fails to a script (STUB_PLAN, one "rc:stderr" per
# call, the last step repeating), which is what makes the interesting cases
# reachable: a changed host key, an expired certificate, a drop halfway through a
# remote command. The credential tests all run with stdin closed, because the one
# thing they assert is that nothing ever waits on a human.
#
# Usage: ./test-ssa

set -uo pipefail

SSA=$(cd "$(dirname "$0")" && pwd)/ssa
T=$(mktemp -d "${TMPDIR:-/tmp}/ssa-test.XXXXXX")
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/bin"

cat >"$T/bin/ssh" <<'STUB'
#!/usr/bin/env bash
# `-G` answers config questions without connecting, exactly as ssh does; every
# other invocation is a session (or a probe, which is a session too) and consumes
# the next step of STUB_PLAN, repeating the last step once it runs out.
if [[ " $* " == *" -G "* ]]; then
    printf 'hostname %s\nport 22\nuser tester\n' "${STUB_HOST:-testhost}"
    exit 0
fi
n=$(cat "$STUB_COUNT" 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" >"$STUB_COUNT"
printf '%d\t%s\n' "$n" "$*" >>"$STUB_LOG"
IFS=';' read -ra plan <<<"$STUB_PLAN"
step=${plan[$((n - 1))]:-${plan[$((${#plan[@]} - 1))]}}
rc=${step%%:*}
msg=${step#*:}
[[ -n $msg && $msg != "$step" ]] && printf '%s\n' "$msg" >&2
exit "$rc"
STUB
chmod +x "$T/bin/ssh"

export PATH="$T/bin:$PATH"
export STUB_COUNT=$T/count STUB_LOG=$T/log
# No real certificate, no keypress window, short timeouts: the point is the
# control flow, not the clock.
export SSA_CERT=/nonexistent SSA_GRACE=0 SSA_PROBE_TIMEOUT=2 SSA_MAX_WAIT=8

pass=0 fail=0
check() { # check LABEL WANT GOT
    if [[ $2 == "$3" ]]; then
        pass=$((pass + 1))
        printf 'ok   %s\n' "$1"
    else
        fail=$((fail + 1))
        printf 'FAIL %s\n       want: %s\n       got:  %s\n' "$1" "$2" "$3"
    fi
}
reset() { : >"$T/log"; echo 0 >"$STUB_COUNT"; }
sessions() { grep -c . "$T/log"; }
first_argv() { awk -F'\t' 'NR == 1 { print $2 }' "$T/log"; }

# --- exit status is the remote's, not ours -----------------------------------

reset
STUB_PLAN='3:' $SSA host true >/dev/null 2>&1
check "remote exit 3 passes through" 3 $?

reset
STUB_PLAN='0:' $SSA host >/dev/null 2>&1
check "clean exit 0" 0 $?
check "clean exit does not reconnect" 1 "$(sessions)"

# --- failures that must not be retried ---------------------------------------

reset
out=$(STUB_PLAN='255:@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED @@@' \
    $SSA host 2>&1)
check "changed host key exits 255" 255 $?
check "changed host key is not retried" 1 "$(sessions)"
case $out in
    *changed*) check "changed host key explains itself" y y ;;
    *) check "changed host key explains itself" y "n: $out" ;;
esac

# --- failures that must be retried -------------------------------------------

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host 2>&1)
check "reconnect after a timeout exits 0" 0 $?
case $out in
    *"is back after"*) check "reconnect is announced" y y ;;
    *) check "reconnect is announced" y "n: $out" ;;
esac
if grep -q 'BatchMode=yes' "$T/log"; then
    check "reconnect probes quietly first" y y
else
    check "reconnect probes quietly first" y n
fi

# --- a remote command that may have half-run ---------------------------------

reset
out=$(STUB_PLAN='255:Connection to host closed by remote host.;0:' \
    $SSA host 'make deploy' 2>&1)
check "dropped remote command exits 255" 255 $?
check "dropped remote command runs once" 1 "$(sessions)"
case $out in
    *"already run"*) check "dropped remote command explains itself" y y ;;
    *) check "dropped remote command explains itself" y "n: $out" ;;
esac

reset
STUB_PLAN='255:Connection to host closed by remote host.;0:;0:' \
    $SSA --retry-command host 'tail -F log' >/dev/null 2>&1
check "--retry-command opts back in" 0 $?

# --- bounded waiting --------------------------------------------------------

reset
start=$(date +%s)
STUB_PLAN='255:ssh: connect to host port 22: Connection refused;255:' \
    $SSA --max-wait=4 host >/dev/null 2>&1
check "max-wait gives up with 255" 255 $?
elapsed=$(($(date +%s) - start))
if [[ $elapsed -lt 20 ]]; then verdict=bounded; else verdict="${elapsed}s"; fi
check "max-wait bounds the wait (${elapsed}s elapsed)" bounded "$verdict"

# --- argument handling ------------------------------------------------------

reset
STUB_PLAN='0:' $SSA --tmux=build -p 2222 -J bastion host >/dev/null 2>&1
check "ssh keeps its flags, tmux is appended" \
    "-p 2222 -J bastion -t host tmux new -A -s build" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA -tp2222 host uptime >/dev/null 2>&1
check "clustered -tp2222 stays intact" "-tp2222 host uptime" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA host 'echo *' >/dev/null 2>&1
check "remote command is not globbed locally" "host echo *" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA --tmux host uptime >/dev/null 2>&1
check "--tmux plus a command is refused" 255 $?

reset
STUB_PLAN='0:' $SSA --nonsense host >/dev/null 2>&1
check "unknown long option is refused" 255 $?

$SSA --help >/dev/null 2>&1
check "--help exits 0" 0 $?

# --- credentials are waited on, never asked for ------------------------------
# Nothing here may prompt, invoke mwinit, or dead-end on a missing terminal: a
# rejection is a thing to wait for. Hence `</dev/null` throughout -- no tty is
# available, and it must still reconnect on its own.

reset
out=$(STUB_PLAN='255:Permission denied (publickey).;0:;0:' $SSA host </dev/null 2>&1)
check "rejected credentials, then accepted, exits 0" 0 $?
case $out in
    *"credentials rejected"*) check "what it waits for is named" y y ;;
    *) check "what it waits for is named" y "n: $out" ;;
esac

reset
out=$(STUB_PLAN='255:Permission denied (publickey).' \
    $SSA --max-wait=3 host </dev/null 2>&1)
check "rejection with no tty times out, never prompts" 255 $?
case $out in
    *"gave up"*) check "timing out is why it stopped" y y ;;
    *) check "timing out is why it stopped" y "n: $out" ;;
esac

# A live certificate cannot be forged, so stub the reader instead. The cert is
# only ever *read*, to explain a rejection.
: >"$T/cert"
keygen_says() {
    cat >"$T/bin/ssh-keygen" <<STUB
#!/usr/bin/env bash
echo "        Valid: from 2020-01-01T00:00:00 to $1"
STUB
    chmod +x "$T/bin/ssh-keygen"
}

keygen_says 2020-01-02T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' SSA_CERT=$T/cert \
    $SSA --max-wait=3 host </dev/null 2>&1)
case $out in
    *"certificate expired"*) check "an expired cert explains the rejection" y y ;;
    *) check "an expired cert explains the rejection" y "n: $out" ;;
esac

# A rejection with a live cert is not a cert problem, and saying so is the point:
# another mwinit would not help.
keygen_says 2099-01-01T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' SSA_CERT=$T/cert \
    $SSA --max-wait=3 host </dev/null 2>&1)
case $out in
    *"not the cert"*) check "a live cert is ruled out explicitly" y y ;;
    *) check "a live cert is ruled out explicitly" y "n: $out" ;;
esac

rm "$T/bin/ssh-keygen"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
