#!/usr/bin/env bash
# Drive ssa against a stub ssh, so the parts that only run when the network is
# broken can be tested while it works.
#
# The stub records its argv and fails to a script (STUB_PLAN, one "rc:stderr" per
# call, the last step repeating), which is what makes the interesting cases
# reachable: a changed host key, an expired certificate, a drop halfway through a
# remote command. The credential tests all run with stdin closed, because the one
# thing they assert is that nothing ever waits on a human.
#
# Usage: ./test-ssa

set -uo pipefail

SSA=$(cd "$(dirname "$0")" && pwd)/ssa
T=$(mktemp -d "${TMPDIR:-/tmp}/ssa-test.XXXXXX")
trap 'rm -r "$T"' EXIT
mkdir -p "$T/bin"

cat >"$T/bin/ssh" <<'STUB'
#!/usr/bin/env bash
# `-G` answers config questions without connecting, exactly as ssh does; every
# other invocation is a session (or a probe, which is a session too) and consumes
# the next step of STUB_PLAN, repeating the last step once it runs out.
if [[ " $* " == *" -G "* ]]; then
    printf 'hostname %s\nport 22\nuser tester\n' "${STUB_HOST:-testhost}"
    printf 'serveraliveinterval %s\n' "${STUB_ALIVE:-0}"
    exit 0
fi
n=$(cat "$STUB_COUNT" 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" >"$STUB_COUNT"
printf '%d\t%s\n' "$n" "$*" >>"$STUB_LOG"
if [[ -n ${STUB_HOLD:-} ]]; then
    printf '%s\n' "$$" >"$STUB_HOLD"
    exec sleep 60
fi
IFS=';' read -ra plan <<<"$STUB_PLAN"
step=${plan[$((n - 1))]:-${plan[$((${#plan[@]} - 1))]}}
rc=${step%%:*}
msg=${step#*:}
[[ -n $msg && $msg != "$step" ]] && printf '%s\n' "$msg" >&2
exit "$rc"
STUB
chmod +x "$T/bin/ssh"

# Keep wait-path tests offline and deterministic. Individual cases override the
# response to model a portal intercepting the connectivity check.
cat >"$T/bin/curl" <<'STUB'
#!/usr/bin/env bash
printf '%s' "${STUB_PORTAL_CODE:-204}"
STUB
chmod +x "$T/bin/curl"

export PATH="$T/bin:$PATH"
export STUB_COUNT=$T/count STUB_LOG=$T/log
# No real certificate, no keypress window, short timeouts: the point is the
# control flow, not the clock.
export SSA_CERT=/nonexistent SSA_GRACE=0 SSA_PROBE_TIMEOUT=2 SSA_MAX_WAIT=8
# ssa refuses a host whose config has no ServerAliveInterval, so the stub
# reports one; STUB_ALIVE=0 is how the two tests below exercise that refusal.
export STUB_ALIVE=60

pass=0 fail=0
check() { # check LABEL WANT GOT
    if [[ $2 == "$3" ]]; then
        pass=$((pass + 1))
        printf 'ok   %s\n' "$1"
    else
        fail=$((fail + 1))
        printf 'FAIL %s\n       want: %s\n       got:  %s\n' "$1" "$2" "$3"
    fi
}
reset() { : >"$T/log"; echo 0 >"$STUB_COUNT"; }
sessions() { grep -c . "$T/log"; }
nth_argv() { awk -F'\t' -v n="$1" 'NR == n { print $2 }' "$T/log"; }
first_argv() { nth_argv 1; }
last_argv() { awk -F'\t' 'END { print $2 }' "$T/log"; }
probe_argv() { awk -F'\t' '$2 ~ /ConnectTimeout=/ { print $2; exit }' "$T/log"; }
yn() { if (($1)); then echo y; else echo n; fi; }


# --- exit status is the remote's, not ours -----------------------------------

reset
STUB_PLAN='3:' $SSA host true >/dev/null 2>&1
check "remote exit 3 passes through" 3 $?

reset
STUB_PLAN='0:' $SSA host >/dev/null 2>&1
check "clean exit 0" 0 $?
check "clean exit does not reconnect" 1 "$(sessions)"
case " $(first_argv) " in
    *" -o BatchMode=yes "*) check "the real session cannot prompt" y y ;;
    *) check "the real session cannot prompt" y "n: $(first_argv)" ;;
esac

# --- failures that must not be retried ---------------------------------------

reset
out=$(STUB_PLAN='255:@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED @@@' \
    $SSA host 2>&1)
check "changed host key exits 255" 255 $?
check "changed host key is not retried" 1 "$(sessions)"
case $out in
    *changed*) check "changed host key explains itself" y y ;;
    *) check "changed host key explains itself" y "n: $out" ;;
esac

# Remote stderr and ssh's own diagnostics share one fd. A command can print an
# auth- or connect-looking line before returning 255, so no classifier can prove
# it never started: replay always requires the explicit opt-in.
reset
out=$(STUB_PLAN='255:Permission denied inside remote command;0:' \
    $SSA host 'make deploy' 2>&1)
check "auth-looking remote exit 255 stays 255" 255 $?
check "auth-looking remote exit is not replayed" 1 "$(sessions)"
case $out in
    *"already run"*) check "ambiguous remote exit explains itself" y y ;;
    *) check "ambiguous remote exit explains itself" y "n: $out" ;;
esac

# --- failures that must be retried -------------------------------------------

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host 2>&1)
check "reconnect after a timeout exits 0" 0 $?
case $out in
    *"is back after"*) check "reconnect is announced" y y ;;
    *) check "reconnect is announced" y "n: $out" ;;
esac
if grep -q 'BatchMode=yes' "$T/log"; then
    check "reconnect probes quietly first" y y
else
    check "reconnect probes quietly first" y n
fi

# -N is useful for a forwarding-only session, but on a probe it suppresses the
# appended `true` and makes a healthy connection live forever. The real sessions
# keep it; only the finite probe drops it.
reset
STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA -N -L 8080:localhost:80 host >/dev/null 2>&1
check "a forwarding-only session reconnects" 0 $?
case " $(probe_argv) " in
    *" -N "*) check "the reconnect probe drops -N" y "n: $(probe_argv)" ;;
    *) check "the reconnect probe drops -N" y y ;;
esac
case " $(last_argv) " in
    *" -N "*) check "the reconnected session keeps -N" y y ;;
    *) check "the reconnected session keeps -N" y "n: $(last_argv)" ;;
esac

# --- what a night away looks like --------------------------------------------
# The probe cadence and the print cadence are separate: a line per probe is
# ~1100 identical lines over a nine-hour outage, each long enough to wrap. So an
# unchanged reason is silent, a changed one is news, and a keep-alive line comes
# once per SSA_NOTE_EVERY. All three are asserted, because the first assertion
# alone would also pass if printing were broken outright.

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    $SSA host </dev/null 2>&1)
check "a steady reason waits through several probes" y "$(yn "$(sessions) >= 3")"
check "a steady reason is not reprinted per probe" 0 "$(grep -c '(waited' <<<"$out")"

reset
out=$(SSA_NOTE_EVERY=1 STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    $SSA host </dev/null 2>&1)
check "a keep-alive line arrives once per SSA_NOTE_EVERY" y \
    "$(yn "$(grep -c '(waited' <<<"$out") >= 2")"

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;255:ssh: connect to host port 22: Connection refused' \
    $SSA host </dev/null 2>&1)
case $out in
    *"connection refused (waited"*) check "a changed reason is reported once" y y ;;
    *) check "a changed reason is reported once" y "n: $out" ;;
esac
check "the changed reason is not then repeated" 1 "$(grep -c '(waited' <<<"$out")"

# The two stale-master checks consume steps before the real availability probe.
reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;255:;255:;255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host </dev/null 2>&1)
case $out in
    *"captive portal"*) check "a portal refines a connection failure" y y ;;
    *) check "a portal refines a connection failure" y "n: $out" ;;
esac

reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:Permission denied (publickey).;255:;255:;255:Permission denied (publickey).;0:;0:' \
    $SSA host </dev/null 2>&1)
case $out in
    *"captive portal"*) check "a portal guess cannot hide rejected credentials" y "n: $out" ;;
    *) check "a portal guess cannot hide rejected credentials" y y ;;
esac

# --- a remote command that may have half-run ---------------------------------

reset
out=$(STUB_PLAN='255:Connection to host closed by remote host.;0:' \
    $SSA host 'make deploy' 2>&1)
check "dropped remote command exits 255" 255 $?
check "dropped remote command runs once" 1 "$(sessions)"
case $out in
    *"already run"*) check "dropped remote command explains itself" y y ;;
    *) check "dropped remote command explains itself" y "n: $out" ;;
esac

reset
STUB_PLAN='255:Connection to host closed by remote host.;0:;0:' \
    $SSA --retry-command host 'tail -F log' >/dev/null 2>&1
check "--retry-command opts back in" 0 $?

# --- bounded waiting ---------------------------------------------------------

reset
start=$(date +%s)
STUB_PLAN='255:ssh: connect to host port 22: Connection refused;255:' \
    $SSA --max-wait=4 host >/dev/null 2>&1
check "max-wait gives up with 255" 255 $?
elapsed=$(($(date +%s) - start))
if [[ $elapsed -lt 20 ]]; then verdict=bounded; else verdict="${elapsed}s"; fi
check "max-wait bounds the wait (${elapsed}s elapsed)" bounded "$verdict"

# --- argument handling -------------------------------------------------------

reset
STUB_PLAN='0:' $SSA --tmux=build -p 2222 -J bastion host >/dev/null 2>&1
check "ssh keeps its flags, tmux is appended" \
    "-o BatchMode=yes -p 2222 -J bastion -t host tmux -u new -A -s build" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA -tp2222 host uptime >/dev/null 2>&1
check "clustered -tp2222 stays intact" \
    "-o BatchMode=yes -tp2222 host uptime" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA host 'echo *' >/dev/null 2>&1
check "remote command is not globbed locally" \
    "-o BatchMode=yes host echo *" "$(first_argv)"

reset
out=$(STUB_PLAN='0:' $SSA --tmux host uptime 2>&1)
check "--tmux plus a command is refused" 255 $?
case $out in
    *"--tmux=NAME"*) check "the refusal points at --tmux=NAME" y y ;;
    *) check "the refusal points at --tmux=NAME" y "n: $out" ;;
esac

reset
STUB_PLAN='0:' $SSA --nonsense host >/dev/null 2>&1
check "unknown long option is refused" 255 $?

$SSA --help >/dev/null 2>&1
check "--help exits 0" 0 $?

# --- borrowed from autossh ---------------------------------------------------
# -M exists because nothing reconnects if nothing notices the link died, and -f
# is the case autossh special-cases; here it would make the wrapper a silent no-op.

reset
STUB_PLAN='0:' $SSA -f -N -L 8080:localhost:80 host >/dev/null 2>&1
check "-f is refused, not silently unsupervised" 255 $?
check "-f never reaches ssh" 0 "$(sessions)"

reset
STUB_PLAN='0:' $SSA -F /dev/null host >/dev/null 2>&1
check "-F is not mistaken for -f" 0 $?

reset
STUB_PLAN='0:' $SSA -i /tmp/key-for-f host >/dev/null 2>&1
check "an -i path containing f is not mistaken for -f" 0 $?

reset
out=$(STUB_ALIVE=0 STUB_PLAN='0:' $SSA host 2>&1)
check "no ServerAliveInterval is refused" 255 $?
check "no ServerAliveInterval never connects" 0 "$(sessions)"
case $out in
    *ServerAliveInterval*"Host host"*) check "the refusal names the host, not Host *" y y ;;
    *) check "the refusal names the host, not Host *" y "n: $out" ;;
esac

reset
STUB_PLAN='0:' $SSA host >/dev/null 2>&1
check "a configured keepalive connects untouched" \
    "-o BatchMode=yes host" "$(first_argv)"

# --- credentials are waited on, never asked for ------------------------------
# Nothing here may prompt, invoke mwinit, or dead-end on a missing terminal: a
# rejection is a thing to wait for. Hence `</dev/null` throughout -- no tty is
# available, and it must still reconnect on its own.

reset
out=$(STUB_PLAN='255:Permission denied (publickey).;0:;0:' $SSA host </dev/null 2>&1)
check "rejected credentials, then accepted, exits 0" 0 $?
case $out in
    *"credentials rejected"*) check "what it waits for is named" y y ;;
    *) check "what it waits for is named" y "n: $out" ;;
esac

reset
out=$(STUB_PLAN='255:Permission denied (publickey).' \
    $SSA --max-wait=3 host </dev/null 2>&1)
check "rejection with no tty times out, never prompts" 255 $?
case $out in
    *"gave up"*) check "timing out is why it stopped" y y ;;
    *) check "timing out is why it stopped" y "n: $out" ;;
esac

# A live certificate cannot be forged, so stub the reader instead. The cert is
# only ever *read*, to explain a rejection.
: >"$T/cert"
keygen_says() {
    cat >"$T/bin/ssh-keygen" <<STUB
#!/usr/bin/env bash
echo "        Valid: from 2020-01-01T00:00:00 to $1"
STUB
    chmod +x "$T/bin/ssh-keygen"
}

keygen_says 2020-01-02T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' SSA_CERT=$T/cert \
    $SSA --max-wait=3 host </dev/null 2>&1)
case $out in
    *"certificate expired"*) check "an expired cert explains the rejection" y y ;;
    *) check "an expired cert explains the rejection" y "n: $out" ;;
esac

# A rejection with a live cert is not a cert problem, and saying so is the point:
# another mwinit would not help.
keygen_says 2099-01-01T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' SSA_CERT=$T/cert \
    $SSA --max-wait=3 host </dev/null 2>&1)
case $out in
    *"not the cert"*) check "a live cert is ruled out explicitly" y y ;;
    *) check "a live cert is ruled out explicitly" y "n: $out" ;;
esac

rm "$T/bin/ssh-keygen"

# --- signals stop the supervised process ------------------------------------
# A direct TERM (for example from a service manager) reaches the wrapper, not
# necessarily its process group. It must stop the foreground ssh and its tee,
# rather than defer the trap until that session eventually exits on its own.

reset
hold=$T/hold
STUB_HOLD=$hold STUB_PLAN='0:' $SSA host >/dev/null 2>&1 &
wrapper=$!
for _ in {1..40}; do
    [[ -s $hold ]] && break
    sleep 0.05
done
if [[ -s $hold ]]; then child=$(<"$hold"); else child=; fi
check "signal test reaches the ssh child" y "$(if [[ -n $child ]]; then echo y; else echo n; fi)"
kill -TERM "$wrapper" 2>/dev/null
for _ in {1..40}; do
    ! kill -0 "$wrapper" 2>/dev/null && break
    sleep 0.05
done
if kill -0 "$wrapper" 2>/dev/null; then
    wrapper_stopped=n
    [[ -n $child ]] && kill -TERM "$child" 2>/dev/null
else
    wrapper_stopped=y
fi
wait "$wrapper" 2>/dev/null
term_rc=$?
check "TERM stops the wrapper promptly" y "$wrapper_stopped"
check "TERM exits with 128+15" 143 "$term_rc"
if [[ -n $child ]] && kill -0 "$child" 2>/dev/null; then
    child_stopped=n
    kill -TERM "$child" 2>/dev/null
else
    child_stopped=y
fi
check "TERM stops the ssh child" y "$child_stopped"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
