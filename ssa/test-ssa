#!/usr/bin/env bash
# Drive ssa against a stub ssh, so the parts that only run when the network is
# broken can be tested while it works.
#
# Every check is labelled with the property it discharges (T1..T11, stated in
# README.md). A property with no check here is a claim, so the labels are the
# link -- and two checks below hold that link together, in both directions.
#
# The stub records its argv and fails to a script (STUB_PLAN, one "rc:stderr" per
# call, the last step repeating), which is what makes the interesting cases
# reachable: a changed host key, an expired certificate, a drop halfway through a
# remote command. The credential tests all run with stdin closed, because the one
# thing they assert is that nothing ever waits on a human.
#
# Usage: ./test-ssa

set -uo pipefail

SSA=$(cd "$(dirname "$0")" && pwd)/ssa
T=$(mktemp -d "${TMPDIR:-/tmp}/ssa-test.XXXXXX")
trap 'rm -r "$T"' EXIT
mkdir -p "$T/bin"

cat >"$T/bin/ssh" <<'STUB'
#!/usr/bin/env bash
# `-G` answers config questions without connecting, exactly as ssh does; every
# other invocation is a session (or a probe, which is a session too) and consumes
# the next step of STUB_PLAN, repeating the last step once it runs out.
if [[ " $* " == *" -G "* ]]; then
    printf 'hostname %s\nport 22\nuser tester\n' "${STUB_HOST:-testhost}"
    printf 'serveraliveinterval %s\n' "${STUB_ALIVE:-0}"
    # A newer client advertises these; OpenSSH 7.4 does not, and rejects both
    # names, which is why ssa only resets what -G said it understands.
    [[ -n ${STUB_ADVERTISE:-} ]] && printf 'remotecommand none\nsessiontype default\n'
    exit 0
fi
n=$(cat "$STUB_COUNT" 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" >"$STUB_COUNT"
# The third field is whether this invocation was handed the caller's terminal,
# which is what T11 reads back.
printf '%d\t%s\t%s\n' "$n" "$*" "$(if [[ -t 0 ]]; then echo tty; else echo notty; fi)" >>"$STUB_LOG"
# A call that does not come back on its own. STUB_DELAY_CTL is a control socket
# that stopped answering, STUB_DELAY_PROBE a probe wedged past its own
# ConnectTimeout -- the two shapes ssa cannot bound by asking ssh nicely.
if [[ -n ${STUB_DELAY_CTL:-} && " $* " == *" -O "* ]]; then sleep "$STUB_DELAY_CTL"; fi
if [[ -n ${STUB_DELAY_PROBE:-} && " $* " == *"ConnectTimeout="* ]]; then
    sleep "$STUB_DELAY_PROBE"
fi
# A ProxyCommand descendant outliving ssh with fd 2 still open: the write end of
# ssa's fifo stays open, so its tee never reaches EOF. It ignores TERM because a
# grandchild is not ssa's to signal.
if [[ -n ${STUB_ORPHAN:-} ]]; then
    (
        trap '' TERM HUP
        sleep "$STUB_ORPHAN"
    ) &
fi
if [[ -n ${STUB_HOLD:-} ]]; then
    printf '%s\n' "$$" >"$STUB_HOLD"
    exec sleep 60
fi
# Emulate a live ControlMaster reached through a ProxyCommand whose credentials
# have expired: the socket answers, and only an invocation that insists on a
# fresh handshake has to pay for credentials. This is the shape of a Midway or
# SSM-proxied host, and it is what makes probe/session equivalence testable.
if [[ -n ${STUB_MUX_LIVE:-} ]]; then
    [[ " $* " == *" -O check "* ]] && exit 0
    if [[ " $* " == *"ControlPath=none"* ]]; then
        printf '%s\n' 'An error occurred (ExpiredTokenException) when calling the StartSession operation: The security token included in the request is expired' >&2
        printf '%s\n' 'ssh_exchange_identification: Connection closed by remote host' >&2
        exit 255
    fi
fi
IFS=';' read -ra plan <<<"$STUB_PLAN"
step=${plan[$((n - 1))]:-${plan[$((${#plan[@]} - 1))]}}
rc=${step%%:*}
msg=${step#*:}
# %b, so a step can carry a multi-line transcript as \n -- the whole point of the
# mixed-transcript checks, and read(1) above would stop at a real newline.
[[ -n $msg && $msg != "$step" ]] && printf '%b\n' "$msg" >&2
exit "$rc"
STUB
chmod +x "$T/bin/ssh"

# Keep wait-path tests offline and deterministic. Individual cases override the
# response to model a portal intercepting the connectivity check.
cat >"$T/bin/curl" <<'STUB'
#!/usr/bin/env bash
printf '%s' "${STUB_PORTAL_CODE:-204}"
STUB
chmod +x "$T/bin/curl"

export PATH="$T/bin:$PATH"
export STUB_COUNT=$T/count STUB_LOG=$T/log
# ssa reads one certificate path, derived from HOME, so pointing HOME at the
# scratch directory makes every run cert-less unless a check puts one there.
export HOME=$T
mkdir -p "$T/.ssh"
CERTPATH=$T/.ssh/id_rsa-cert.pub
# ssa refuses a host whose config has no ServerAliveInterval, so the stub
# reports one; STUB_ALIVE=0 is how the two tests below exercise that refusal.
export STUB_ALIVE=60

pass=0 fail=0 skipped=0
skip() { skipped=$((skipped + 1)); printf 'skip %s\n' "$1"; }
check() { # check LABEL WANT GOT
    if [[ $2 == "$3" ]]; then
        pass=$((pass + 1))
        printf 'ok   %s\n' "$1"
    else
        fail=$((fail + 1))
        printf 'FAIL %s\n       want: %s\n       got:  %s\n' "$1" "$2" "$3"
    fi
}
reset() { : >"$T/log"; echo 0 >"$STUB_COUNT"; }
sessions() { grep -c . "$T/log"; }
probes() { grep -c 'ConnectTimeout=' "$T/log"; }
nth_argv() { awk -F'\t' -v n="$1" 'NR == n { print $2 }' "$T/log"; }
first_argv() { nth_argv 1; }
last_argv() { awk -F'\t' 'END { print $2 }' "$T/log"; }
probe_argv() { awk -F'\t' '$2 ~ /ConnectTimeout=/ { print $2; exit }' "$T/log"; }
first_row() { awk -F'\t' -v p="$1" '$2 ~ p { print NR; exit }' "$T/log"; }
session_tty() { awk -F'\t' 'NR == 1 { print $3 }' "$T/log"; }
yn() { if (($1)); then echo y; else echo n; fi; }

# ssa has no runtime knobs: it waits forever, reads one cert path, and carries its
# clocks as constants. So a test that needs a different constant generates a copy
# of the script with that line rewritten. The rewrite must match exactly one line
# -- a renamed constant would otherwise leave the check passing while testing
# nothing, which is the failure mode the data checks below exist to prevent.
variant() { # variant NAME=VALUE... -> path to a copy of ssa carrying them
    local out=$T/ssa-variant spec name hits
    cp "$SSA" "$out"
    for spec in "$@"; do
        name=${spec%%=*}
        hits=$(grep -c "^$name=" "$out")
        ((hits == 1)) || {
            printf 'variant: %s matches %s lines of %s\n' "$name" "$hits" "$SSA" >&2
            return 1
        }
        sed -i "s|^$name=.*|$spec|" "$out"
    done
    chmod +x "$out"
    printf '%s' "$out"
}
# ssa waits forever, as an interactive tool should, so a test that wants to watch
# it wait stops it from the outside. 124 is the timeout's own status and means
# "still waiting", which for most of these is the point being asserted.
watch() { # watch SECS cmd... -> its stderr; WATCH_RC is how it ended
    local secs=$1
    shift
    local out
    out=$(timeout "$secs" "$@" </dev/null 2>&1)
    WATCH_RC=$?
    printf '%s' "$out"
}
WATCH_RC=0

# A live certificate cannot be forged, so stub the reader instead. The cert is
# only ever *read*, to explain a rejection.
keygen_says() {
    cat >"$T/bin/ssh-keygen" <<STUB
#!/usr/bin/env bash
# -f names the cert; a missing one is an error, as it is for the real ssh-keygen.
[[ -f \${!#} ]] || exit 1
echo "        Valid: from 2020-01-01T00:00:00 to $1"
STUB
    chmod +x "$T/bin/ssh-keygen"
}
# The failure table read back out of the script, so the two checks below hold the
# data itself to the theorems rather than sampling its behaviour.
table() { sed -n "/^FAILURES='/,/'\$/p" "$SSA" | sed "s/^FAILURES='//; s/'\$//" | grep .; }


# --- the gate runs itself ------------------------------------------------------
# Parsing and linting are part of the suite, not a habit someone remembers to
# perform before committing.

bash -n "$SSA" 2>/dev/null
check "the script parses" 0 $?
if command -v shellcheck >/dev/null 2>&1; then
    check "shellcheck is clean" "" "$(shellcheck "$SSA" "$0" 2>&1)"
else
    skip 'shellcheck: not installed'
fi

# A property with no check is a claim, and a check labelled for a property nobody
# stated is a habit. README.md's table states them, the labels below discharge
# them, and this holds the two together so neither can drift.
stated=$(awk -F'|' '/^\| *T[0-9]+ *\|/ { gsub(/ /, "", $2); print $2 }' \
    "$(dirname "$SSA")/README.md" | sort -u)
proven=$(grep -oE '"T[0-9]+ ' "$0" | tr -d '" ' | sort -u)
check "every stated property has a check" "" "$(comm -23 <(echo "$stated") <(echo "$proven"))"
check "every labelled check has a stated property" "" "$(comm -13 <(echo "$stated") <(echo "$proven"))"

# --- T4  status transparency ---------------------------------------------------
# Any ssh status other than 255 is the remote command's and is ssa's.

reset
STUB_PLAN='3:' $SSA host true >/dev/null 2>&1
check "T4 remote exit 3 passes through" 3 $?

reset
STUB_PLAN='0:' $SSA host >/dev/null 2>&1
check "T4 clean exit 0" 0 $?
check "T4 clean exit does not reconnect" 1 "$(sessions)"

# --- T5  no blocking prompt ----------------------------------------------------
# Nothing ssa starts may read from a human, so BatchMode=yes leads both argvs and
# cannot be overridden: ssh keeps the first value it obtains for an option.

case " $(first_argv) " in
    *" -o BatchMode=yes "*) check "T5 the real session cannot prompt" y y ;;
    *) check "T5 the real session cannot prompt" y "n: $(first_argv)" ;;
esac

# --- T6  trust is never repaired -----------------------------------------------

reset
out=$(STUB_PLAN='255:@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED @@@' \
    $SSA host 2>&1)
check "T6 changed host key exits 255" 255 $?
check "T6 changed host key is not retried" 1 "$(sessions)"
case $out in
    *"host key changed"*) check "T6 changed host key names the cause" y y ;;
    *) check "T6 changed host key names the cause" y "n: $out" ;;
esac
case $out in
    *MITM*) check "T6 the ambiguity with a rebuilt host is stated" y y ;;
    *) check "T6 the ambiguity with a rebuilt host is stated" y "n: $out" ;;
esac

# --- T3  at-most-once command --------------------------------------------------
# Remote stderr and ssh's own diagnostics share one fd. A command can print an
# auth- or connect-looking line before returning 255, so no classifier can prove
# it never started: replay always requires the explicit opt-in.

reset
out=$(STUB_PLAN='255:Permission denied inside remote command;0:' \
    $SSA host 'make deploy' 2>&1)
check "T3 auth-looking remote exit 255 stays 255" 255 $?
check "T3 auth-looking remote exit is not replayed" 1 "$(sessions)"
case $out in
    *"may have run"*) check "T3 ambiguous remote exit explains itself" y y ;;
    *) check "T3 ambiguous remote exit explains itself" y "n: $out" ;;
esac

reset
out=$(STUB_PLAN='255:Connection to host closed by remote host.;0:' \
    $SSA host 'make deploy' 2>&1)
check "T3 dropped remote command exits 255" 255 $?
check "T3 dropped remote command runs once" 1 "$(sessions)"
case $out in
    *"may have run"*) check "T3 dropped remote command explains itself" y y ;;
    *) check "T3 dropped remote command explains itself" y "n: $out" ;;
esac
case $out in
    *--tmux*) check "T3 the refusal points at the way to survive a drop" y y ;;
    *) check "T3 the refusal points at the way to survive a drop" y "n: $out" ;;
esac

# --- T1  probe fidelity --------------------------------------------------------
# A probe answers one question -- would the session connect? -- so it may bound
# the attempt and make it finite, and may not change how the connection is made.

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host 2>&1)
check "T1 reconnect after a timeout exits 0" 0 $?
case $out in
    *"back after"*) check "T1 reconnect is announced" y y ;;
    *) check "T1 reconnect is announced" y "n: $out" ;;
esac
case " $(probe_argv) " in
    *" -o BatchMode=yes "*) check "T5 reconnect probes cannot prompt either" y y ;;
    *) check "T5 reconnect probes cannot prompt either" y "n: $(probe_argv)" ;;
esac

# The check that would have caught the regression this list exists for: these six
# -o names bound the attempt or make it finite. Any other one the probe adds --
# ControlPath, an identity, a proxy, a cipher -- changes how the connection is
# made, so the probe could then fail where the session succeeds. The invocation
# above passes no -o of its own, so every name here is ssa's.
bounding='BatchMode ConnectTimeout ControlMaster ClearAllForwardings RemoteCommand SessionType'
extra=$(awk '{ for (i = 2; i <= NF; i++) if ($(i - 1) == "-o") print $i }' <<<"$(probe_argv)" |
    sed 's/=.*//' | while read -r o; do [[ " $bounding " == *" $o "* ]] || echo "$o"; done)
check "T1 the probe adds only options that bound the attempt" "" "$extra"

# Inheriting ControlPath is only safe because a socket the master left behind is
# cleared first: order is what makes "a probe reaches a live master or none" true,
# so the order is asserted rather than argued.
check "T1 the stale-master check precedes the first probe" y \
    "$(yn "$(first_row '-O check') < $(first_row 'ConnectTimeout=')")"

# A live master is how the session will reconnect. A probe that insists on a
# fresh handshake waits for credentials the session does not need, which is a
# proxied host (Midway, SSM) refusing to come back after mwinit lapsed.
reset
STUB_MUX_LIVE=1 STUB_PLAN='255:Connection to host closed by remote host.;0:' \
    $SSA host </dev/null >/dev/null 2>&1
check "T1 a probe reaches a live control master" 0 $?

# -N was useful for a forwarding-only session, and is now refused with the rest of
# ssh's flags: LocalForward plus SessionType none in a Host block does the same
# thing, survives a reconnect without ssa passing anything, and leaves the probe a
# fixed argv rather than a filtered copy of the caller's.
reset
out=$($SSA -N -L 8080:localhost:80 host 2>&1)
check "T1 an ssh flag is refused, not filtered" 255 $?
check "T1 a refused flag never connects" 0 "$(sessions)"
case $out in
    *"~/.ssh/config"*) check "T1 the refusal points at ssh_config" y y ;;
    *) check "T1 the refusal points at ssh_config" y "n: $out" ;;
esac

# --- T2  every probe terminates ------------------------------------------------
# The appended command is what makes a *healthy* probe finite, and ssh_config can
# suppress it two ways: RemoteCommand replaces it, SessionType none forbids one.
# ssa resets both -- but only on a client whose -G advertised them, because
# OpenSSH 7.4 rejects the names outright. Nothing tested this before.
reset
STUB_ADVERTISE=1 \
    STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host </dev/null >/dev/null 2>&1
p=$(probe_argv)
case $p in
    *"-o RemoteCommand=none"*"-o SessionType=default"*)
        check "T2 a probe resets what would suppress its command" y y ;;
    *) check "T2 a probe resets what would suppress its command" y "n: $p" ;;
esac
case $p in
    *" true") check "T2 and ends with the command that makes it finite" y y ;;
    *) check "T2 and ends with the command that makes it finite" y "n: $p" ;;
esac
# On a client that does not advertise them, passing the reset would fail the probe
# outright -- which reads as an outage that is not happening.
reset
STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host </dev/null >/dev/null 2>&1
case " $(probe_argv) " in
    *RemoteCommand* | *SessionType*)
        check "T2 an older client is not sent options it rejects" y "n: $(probe_argv)" ;;
    *) check "T2 an older client is not sent options it rejects" y y ;;
esac

# --- T9  bounded, single-clause output -----------------------------------------
# The probe cadence and the print cadence are separate: a line per probe is
# ~1100 identical lines over a nine-hour outage, each long enough to wrap. So an
# unchanged reason is silent, a changed one is news, and a keep-alive line comes
# once per NOTE_EVERY. All three are asserted, because the first assertion alone
# would also pass if printing were broken outright.

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    watch 8 "$SSA" host)
check "T9 a steady reason waits through several probes" y "$(yn "$(sessions) >= 3")"
check "T9 a steady reason is not reprinted per probe" 0 "$(grep -c 'still waiting' <<<"$out")"

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    watch 8 "$(variant NOTE_EVERY=1)" host)
check "T9 a keep-alive line arrives once per NOTE_EVERY" y \
    "$(yn "$(grep -c 'still waiting' <<<"$out") >= 2")"

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;255:ssh: connect to host port 22: Connection refused' \
    watch 8 "$SSA" host)
case $out in
    *"still waiting after"*"connection refused"*) check "T9 a changed reason is reported once" y y ;;
    *) check "T9 a changed reason is reported once" y "n: $out" ;;
esac
check "T9 the changed reason is not then repeated" 1 "$(grep -c 'still waiting' <<<"$out")"

# A reason worded with a duration ticks between probes, so comparing the rendered
# reason reports a change on every one of them and NOTE_EVERY never throttles
# anything. Measured before the fix: 5 lines in 12 s where this predicts 2. The
# credential path is the one that matters, because a cert that expired minutes ago
# is exactly when you are waiting.
reset
: >"$CERTPATH"
keygen_says "$(date -d '-90 seconds' +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo 2020-01-02T00:00:00)"
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 6 "$SSA" host)
check "T9 a ticking duration in the reason does not defeat the cadence" 0 \
    "$(grep -c 'still waiting' <<<"$out")"

# Every status line is "ssa: <state>: <reason>", and the widest state clause fixes
# what a reason may occupy. Recomputed from the grammar rather than copied, then
# every shape is rendered at its worst case -- which is how a line reaching 97
# columns was caught while a check that sampled one real run saw nothing.
prefix='ssa: waiting for ' host_max=20
budget=$((80 - ${#prefix} - host_max - 2))
long=$(table | awk -F'|' -v b="$budget" 'length($2) > b { print $2 }')
check "T9 every reason in the table fits an 80-column line" "" "$long"
cap=$(awk -F= '/^REASON_MAX=/ { print $2; exit }' "$SSA")
check "T9 the cap on ssh's own wording matches that bound" y "$(yn "$cap <= $budget")"
h=$(printf "%${host_max}s" '' | tr ' ' x) r=$(printf "%${budget}s" '' | tr ' ' x) d=543h00m
over=
for shape in "ssa: waiting for $h: $r" "ssa: still waiting after $d: $r" \
    "ssa: $h back after $d, reconnecting" "ssa: not reconnecting: $r"; do
    ((${#shape} <= 80)) || over+="${#shape} cols: $shape"$'\n'
done
check "T9 every status shape fits 80 columns at its worst case" "" "$over"

# An overnight wait is the case this cadence exists for, so its duration has to
# read as one: minutes alone give "655m00s".
reset
keygen_says "$(date -d '-11 hours' +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo 2020-01-02T00:00:00)"
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 3 "$SSA" host)
if grep -qE 'cert expired [0-9]+h[0-9]{2}m ago' <<<"$out"; then
    check "T9 an overnight duration reads in hours" y y
else
    check "T9 an overnight duration reads in hours" y "n: $out"
fi
# Nothing ssa writes may itself wrap, which is the failure the cadence exists to
# avoid. Its own lines are checked here; ssh's verbatim output is ssh's business.
wide=$(grep -n '^ssa: ' <<<"$out" | awk -F: 'length($0) - length($1) - 1 > 80')
check "T9 no line ssa wrote exceeds 80 columns" "" "$wide"
# Back to cert-less, so a later check reads the row it is driving and not a
# certificate this block left lying around.
rm -f "$CERTPATH"

# --- T10  one diagnosis --------------------------------------------------------
# One table maps stderr to a class and a sentence, so the two cannot disagree.
# These two checks hold the table itself to that, not a sample of its behaviour.

dupes=$(table | awk -F'|' '{ print $3 }' | sort | uniq -d)
check "T10 no failure pattern appears twice" "" "$dupes"
shape=$(table | awk -F'|' '$1 !~ /^(fatal|auth|connect)$/ || NF != 3 { print NR": "$0 }')
check "T10 every row is a known class and three fields" "" "$shape"

# Every row driven end to end, so the clause the table promises is the clause that
# reaches the terminal. One loop over the data, so a row added later is proven the
# moment it is added rather than when someone remembers to add a case for it.
unproven=
while IFS='|' read -r _ phrase pat; do
    reset
    out=$(STUB_PLAN="255:$pat" watch 2 "$SSA" host)
    [[ $out == *"$phrase"* ]] ||
        unproven+="[$pat] wanted '$phrase', said: $(grep '^ssa: ' <<<"$out" | head -1)"$'\n'
done < <(table)
check "T10 every row's clause is what reaches the terminal" "" "$unproven"

# A host rebuilt during the outage being waited out is the ordinary way a key
# changes mid-wait, and waiting cannot fix it whoever noticed first.
reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection refused;255:;255:;255:@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED @@@' \
    $SSA host </dev/null 2>&1)
check "T6 a fatal reason found while waiting stops the wait" 255 $?
case $out in
    *"not reconnecting: host key changed"*) check "T6 stopping mid-wait names the cause" y y ;;
    *) check "T6 stopping mid-wait names the cause" y "n: $out" ;;
esac

# A session with a tty ends its stderr lines with CR. Left in, it sends the cursor
# back over our own "ssa: " prefix on the next write.
reset
out=$(STUB_PLAN=$'255:Connection to host closed by remote host.\r' watch 2 "$SSA" host)
ours=$(grep '^ssa: ' <<<"$out")
case $ours in
    *$'\r'*) check "T9 a tty's carriage returns do not reach the status line" y "n: $(cat -v <<<"$ours")" ;;
    *) check "T9 a tty's carriage returns do not reach the status line" y y ;;
esac

# A proxy standing in for the network is part of connecting, so its diagnostic is
# the reason -- not the generic handshake failure ssh reports underneath it, and
# not 46 truncated characters of a botocore traceback.
reset
out=$(STUB_PLAN='255:An error occurred (ExpiredTokenException) when calling the StartSession operation: The security token included in the request is expired' \
    watch 3 "$SSA" host)
case $out in
    *"proxy credentials expired"*) check "T10 expired proxy credentials are named" y y ;;
    *) check "T10 expired proxy credentials are named" y "n: $out" ;;
esac

# The two stale-master checks consume steps before the real availability probe.
reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:ssh: connect to host port 22: Connection timed out;255:;255:;255:ssh: connect to host port 22: Connection timed out;0:;0:' \
    $SSA host </dev/null 2>&1)
case $out in
    *"captive portal"*) check "T10 a portal refines a connection failure" y y ;;
    *) check "T10 a portal refines a connection failure" y "n: $out" ;;
esac

reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:Permission denied (publickey).;255:;255:;255:Permission denied (publickey).;0:;0:' \
    $SSA host </dev/null 2>&1)
case $out in
    *"captive portal"*) check "T10 a portal guess cannot hide rejected credentials" y "n: $out" ;;
    *) check "T10 a portal guess cannot hide rejected credentials" y y ;;
esac

# Measured against the real host on 2026-08-28: an expired or under-privileged
# gpuec2 profile makes the SSM ProxyCommand print a 403 and ssh add its own
# handshake failure underneath. Read from the generic line it said "refused
# mid-handshake" -- a network story for a credentials problem -- and, being a
# connect class, it then went looking for a captive portal.
reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:aws: [ERROR]: An error occurred (403) when calling the StartSession operation: Server authentication failed: <UnauthorizedRequest><message>Forbidden.</message></UnauthorizedRequest>\nssh_exchange_identification: Connection closed by remote host' \
    watch 2 "$SSA" host)
case $out in
    *"refresh AWS credentials"*) check "T10 a proxy 403 names the credentials" y y ;;
    *) check "T10 a proxy 403 names the credentials" y "n: $out" ;;
esac
case $out in
    *"refused mid-handshake"* | *"captive portal"*)
        check "T10 a proxy 403 is not told as a network failure" y "n: $out" ;;
    *) check "T10 a proxy 403 is not told as a network failure" y y ;;
esac

# Only the end of stderr describes how *this* session ended. ssh's own verbose
# output reports a refusal per address it tries before connecting through another,
# and a remote command's stderr shares the stream, so searching all of it
# diagnoses a drop from a line belonging to an attempt that recovered -- and, as a
# connect class, guesses at a portal too.
reset
out=$(STUB_PORTAL_CODE=302 \
    STUB_PLAN='255:debug1: connect to address 10.0.0.1 port 22: Connection refused\ndebug1: Connecting to host port 22.\ndebug1: Connection established.\ndebug1: Authentication succeeded (publickey).\nConnection to host closed by remote host.' \
    watch 2 "$SSA" host)
case $out in
    *"closed by remote host"*) check "T10 a drop is read from the line that ended it" y y ;;
    *) check "T10 a drop is read from the line that ended it" y "n: $out" ;;
esac
case $out in
    *"connection refused"* | *"captive portal"*)
        check "T10 an earlier line that recovered is not the reason" y "n: $out" ;;
    *) check "T10 an earlier line that recovered is not the reason" y y ;;
esac

# --- T12  every ssh ssa starts is bounded ----------------------------------------
# ssa waits forever on purpose, so the bound that matters is per call: without one
# a single wedged probe *is* the whole wait. ConnectTimeout does not apply to a
# connection handed to a live master, and -O check has no bound of its own, so the
# hard kill is the only thing making the loop a loop. Both are driven with a stub
# that never returns and a PROBE_WALL of 1s: bounded, several probes happen in the
# window; unbounded, the first one consumes it.

reset
STUB_DELAY_PROBE=9 STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    watch 6 "$(variant PROBE_WALL=1)" host >/dev/null
check "T12 a probe that will not return is cut off" y "$(yn "$(probes) >= 2")"

reset
out=$(STUB_DELAY_CTL=9 STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    watch 6 "$(variant PROBE_WALL=1)" host)
check "T12 a control socket that will not answer is cut off too" y "$(yn "$(probes) >= 1")"
case $out in
    *"waiting for"*) check "T12 the wait is entered, not blocked before it" y y ;;
    *) check "T12 the wait is entered, not blocked before it" y "n: $out" ;;
esac

# --- T13  a descendant cannot stall the wrapper ----------------------------------
# ssh's stderr is a fifo so it can pass through live and be read back. A
# ProxyCommand descendant inherits the write end, so tee never reaches EOF, and
# waiting on tee let a grandchild hold up the diagnosis for its own lifetime --
# measured at 5s for a 5s child. The drain is bounded at DRAIN and then tee is
# stopped, so the wait starts while that child is still alive.
reset
out=$(STUB_ORPHAN=9 STUB_PLAN='255:ssh: connect to host port 22: Connection timed out' \
    watch 4 "$SSA" host)
case $out in
    *"waiting for"*"connection timed out"*)
        check "T13 a descendant holding stderr does not delay the diagnosis" y y ;;
    *) check "T13 a descendant holding stderr does not delay the diagnosis" y "n: $out" ;;
esac
check "T13 and the probe loop still runs while it lives" y "$(yn "$(probes) >= 1")"

# --- waiting is unbounded on purpose -------------------------------------------
# The only bound is the caller's: a credential that will be refreshed and a VPN
# that will come back are both indefinite, so a wrapper that gave up would just be
# a wrapper you have to restart. What must be bounded is each individual call
# (T12), and that it keeps probing rather than blocking is what this asserts.

reset
out=$(STUB_PLAN='255:ssh: connect to host port 22: Connection refused;255:' \
    watch 5 "$SSA" host)
check "a wait is ended by the caller, not by ssa" 124 "$WATCH_RC"
check "and it kept probing while it waited" y "$(yn "$(probes) >= 2")"
case $out in
    *"gave up"*) check "nothing claims to have given up" y "n: $out" ;;
    *) check "nothing claims to have given up" y y ;;
esac

# --- the interface is a host, and nothing else ----------------------------------
# Two options and a host. Every ssh flag is refused with a pointer at ssh_config,
# which is where the probe reads it from anyway, so there is no argv to filter and
# no cluster to walk -- the 42 lines that did are gone, and with them the class of
# bug where a probe kept a flag the session did not, or dropped one it needed.

reset
STUB_PLAN='0:' $SSA --tmux=build host >/dev/null 2>&1
check "the session is the host plus our own flags" \
    "-o BatchMode=yes -t host tmux -u new -A -s build" "$(first_argv)"

reset
STUB_PLAN='0:' $SSA host 'echo *' >/dev/null 2>&1
check "remote command is not globbed locally" \
    "-o BatchMode=yes host echo *" "$(first_argv)"

# A flag *after* the host is the remote command's, not ours to read.
reset
STUB_PLAN='0:' $SSA host uptime -a >/dev/null 2>&1
check "a flag after the host belongs to the remote command" \
    "-o BatchMode=yes host uptime -a" "$(first_argv)"

reset
out=$(STUB_PLAN='0:' $SSA -p 2222 host 2>&1)
check "an ssh flag is refused" 255 $?
case $out in
    *"-p"*"~/.ssh/config"*) check "the refusal names the flag and where it goes" y y ;;
    *) check "the refusal names the flag and where it goes" y "n: $out" ;;
esac

reset
out=$(STUB_PLAN='0:' $SSA --tmux host uptime 2>&1)
check "--tmux plus a command is refused" 255 $?
case $out in
    *"--tmux=NAME"*) check "the refusal points at --tmux=NAME" y y ;;
    *) check "the refusal points at --tmux=NAME" y "n: $out" ;;
esac

reset
STUB_PLAN='0:' $SSA --nonsense host >/dev/null 2>&1
check "unknown long option is refused" 255 $?

$SSA --help >/dev/null 2>&1
check "--help exits 0" 0 $?

# --- T7  liveness precondition -------------------------------------------------
# -M exists because nothing reconnects if nothing notices the link died. -f, the
# case autossh special-cases because it would make the wrapper a no-op, is now
# refused by the blanket flag rule rather than by a case of its own.

reset
STUB_PLAN='0:' $SSA -f -N -L 8080:localhost:80 host >/dev/null 2>&1
check "T7 -f is refused, not silently unsupervised" 255 $?
check "T7 -f never reaches ssh" 0 "$(sessions)"

reset
out=$(STUB_ALIVE=0 STUB_PLAN='0:' $SSA host 2>&1)
check "T7 no ServerAliveInterval is refused" 255 $?
check "T7 no ServerAliveInterval never connects" 0 "$(sessions)"
case $out in
    *ServerAliveInterval*"Host host"*) check "T7 the refusal names the host, not Host *" y y ;;
    *) check "T7 the refusal names the host, not Host *" y "n: $out" ;;
esac

reset
STUB_PLAN='0:' $SSA host >/dev/null 2>&1
check "T7 a configured keepalive connects untouched" \
    "-o BatchMode=yes host" "$(first_argv)"

# --- T5  credentials are waited on, never asked for ----------------------------
# Nothing here may prompt, invoke mwinit, or dead-end on a missing terminal: a
# rejection is a thing to wait for. No tty is available in any of these, and it
# must still reconnect on its own.

rm "$T/bin/ssh-keygen"
rm -f "$CERTPATH"

reset
out=$(STUB_PLAN='255:Permission denied (publickey).;0:;0:' $SSA host </dev/null 2>&1)
check "T5 rejected credentials, then accepted, exits 0" 0 $?
case $out in
    *"credentials rejected"*) check "T5 what it waits for is named" y y ;;
    *) check "T5 what it waits for is named" y "n: $out" ;;
esac

reset
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 3 "$SSA" host)
check "T5 a rejection with no tty waits rather than prompting" 124 "$WATCH_RC"
case $out in
    *"waiting for"*"credentials rejected"*) check "T5 and says so once" y y ;;
    *) check "T5 and says so once" y "n: $out" ;;
esac

: >"$CERTPATH"
keygen_says 2020-01-02T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 3 "$SSA" host)
case $out in
    *"cert expired"*) check "T10 an expired cert explains the rejection" y y ;;
    *) check "T10 an expired cert explains the rejection" y "n: $out" ;;
esac

# A rejection with a live cert is not a cert problem, and saying so is the point:
# another mwinit would not help.
# An unreadable certificate is not a diagnosis. `date -d ''` returns midnight
# today, so this used to read "cert expired 19h55m ago" -- indistinguishable from
# the true message, and it sends you to mwinit for nothing.
keygen_says 2020-01-02T00:00:00
reset
rm -f "$CERTPATH"
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 3 "$SSA" host)
case $out in
    *"cert expired"*) check "T10 an unreadable cert is not reported as expired" y "n: $out" ;;
    *) check "T10 an unreadable cert is not reported as expired" y y ;;
esac

: >"$CERTPATH"
keygen_says 2099-01-01T00:00:00
reset
out=$(STUB_PLAN='255:Permission denied (publickey).' watch 3 "$SSA" host)
case $out in
    *"cert is live"*) check "T10 a live cert is ruled out explicitly" y y ;;
    *) check "T10 a live cert is ruled out explicitly" y "n: $out" ;;
esac

# "Too many authentication failures" is a rejection the certificate does not
# explain, so the note must not be attached to every auth failure alike.
keygen_says 2020-01-02T00:00:00
reset
out=$(STUB_PLAN='255:Too many authentication failures for tester' watch 3 "$SSA" host)
case $out in
    *"cert expired"*) check "T10 the cert note is not attached to every rejection" y "n: $out" ;;
    *) check "T10 the cert note is not attached to every rejection" y y ;;
esac

rm "$T/bin/ssh-keygen"
rm -f "$CERTPATH"

# --- T11  terminal ownership ---------------------------------------------------
# ssh runs asynchronously so a signal trap can reach it, and bash hands an
# asynchronous command /dev/null for stdin unless a redirection says otherwise --
# measured: without `<&0` the child reads /dev/null, with it the child reads the
# pty. Everything the wrapper does not implement depends on that one token: `~.`,
# window resize, scrollback, a full-screen program, and the keypress window
# itself. A dying full-screen program also leaves escape bytes in the input queue,
# and those are not someone asking to stop. All three need a pty.

cat >"$T/keypress.py" <<'PY'
import os, pty, select, sys, time
keys = sys.argv[2].encode()
pid, fd = pty.fork()
if pid == 0:
    os.execvp("bash", ["bash", sys.argv[1], "host"])
time.sleep(0.5)
os.write(fd, keys)
buf, t0 = b"", time.time()
while time.time() - t0 < 40:
    try:
        r, _, _ = select.select([fd], [], [], 0.5)
    except OSError:
        break
    if r:
        try:
            d = os.read(fd, 4096)
        except OSError:
            break
        if not d:
            break
        buf += d
sys.stderr.write(buf.decode("utf-8", "replace"))
print(os.WEXITSTATUS(os.waitpid(pid, 0)[1]))
PY

if command -v python3 >/dev/null 2>&1; then
    reset
    rc=$(STUB_PLAN='0:' python3 "$T/keypress.py" "$SSA" '' 2>/dev/null)
    check "T11 the session exits cleanly under a pty" 0 "$rc"
    check "T11 the session inherits the terminal, not /dev/null" tty "$(session_tty)"

    reset
    rc=$(STUB_PLAN='255:Connection to host closed by remote host.;0:' \
        python3 "$T/keypress.py" "$SSA" $'\e[<0;1;1M' 2>/dev/null)
    check "T11 a queued escape sequence does not abort the reconnect" 0 "$rc"

    reset
    rc=$(STUB_PLAN='255:Connection to host closed by remote host.;0:' \
        python3 "$T/keypress.py" "$SSA" q 2>/dev/null)
    check "T11 q still stops the reconnect" 255 "$rc"
else
    skip 'T11: no python3, so no pty'
fi

# --- T8  child containment -----------------------------------------------------
# A direct TERM (for example from a service manager) reaches the wrapper, not
# necessarily its process group. It must stop the ssh child and its tee, rather
# than defer the trap until that session eventually exits on its own.

reset
hold=$T/hold
STUB_HOLD=$hold STUB_PLAN='0:' $SSA host >/dev/null 2>&1 &
wrapper=$!
for _ in {1..40}; do
    [[ -s $hold ]] && break
    sleep 0.05
done
if [[ -s $hold ]]; then child=$(<"$hold"); else child=; fi
check "T8 signal test reaches the ssh child" y "$(if [[ -n $child ]]; then echo y; else echo n; fi)"
kill -TERM "$wrapper" 2>/dev/null
for _ in {1..40}; do
    ! kill -0 "$wrapper" 2>/dev/null && break
    sleep 0.05
done
if kill -0 "$wrapper" 2>/dev/null; then
    wrapper_stopped=n
    [[ -n $child ]] && kill -TERM "$child" 2>/dev/null
else
    wrapper_stopped=y
fi
wait "$wrapper" 2>/dev/null
term_rc=$?
check "T8 TERM stops the wrapper promptly" y "$wrapper_stopped"
check "T8 TERM exits with 128+15" 143 "$term_rc"
if [[ -n $child ]] && kill -0 "$child" 2>/dev/null; then
    child_stopped=n
    kill -TERM "$child" 2>/dev/null
else
    child_stopped=y
fi
check "T8 TERM stops the ssh child" y "$child_stopped"

# The count in README.md is a fact about this file, so it is checked rather than
# trusted -- a number in prose is exactly what drifts. It counts itself, hence the
# +1, and it only means anything when nothing was skipped.
if ((skipped == 0)); then
    check "README.md's check count is current" \
        "$(grep -oE '^[0-9]+ checks against' "$(dirname "$SSA")/README.md" | grep -oE '^[0-9]+')" \
        "$((pass + fail + 1))"
else
    skip "the check count: $skipped check(s) did not run"
fi

printf '\n%d passed, %d failed, %d skipped\n' "$pass" "$fail" "$skipped"
[[ $fail -eq 0 ]]
