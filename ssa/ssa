#!/usr/bin/env python3
"""ssh that waits out a broken network and reconnects.

It disables SSH authentication prompts, reports failures, and retries interactive
connections. README.md describes the behavior and limits; PLAN.md records the
recovery design.

Everything above `Ssh` is pure -- stderr to a decision and a sentence, and the
rendering of a status line -- so it is checked by calling it. Everything below
talks to ssh, with process tests and opt-in tests against a local OpenSSH server.
"""

from __future__ import annotations

import enum
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty
from collections import deque
from collections.abc import Callable, Iterable, Sequence
from dataclasses import dataclass, field

PROG = "ssa"
CERT = "~/.ssh/id_rsa-cert.pub"

GRACE = 3.0  # keypress window before a reconnect, so `~.` can stop it
PROBE_CONNECT = 30  # fallback when ssh_config has no ConnectTimeout
CONNECT_WALL = 45.0  # includes DNS, ProxyCommand startup and authentication
MAX_DELAY = 60.0  # longest gap between probes
DRAIN = 1.0  # grace for ssh's stderr to reach us after ssh itself has exited

# ConnectTimeout does not bound a multiplexed channel or a hung ProxyCommand.
# An established connection's heartbeat gets its own, shorter deadline.
PROBE_WALL = 15.0

# How much of stderr describes how *this* session ended. Two lines is the deepest
# real transcript -- a proxy's diagnostic, and the handshake failure ssh reports
# underneath it -- plus one of slack. Reading the whole stream instead diagnoses
# today's failure from a line left by an attempt that then recovered.
TAIL_LINES = 3

# Probing and printing are separate clocks: a line per probe is fine for a
# 30-second outage and unusable for an overnight one (~540 copies of one
# sentence at the MAX_DELAY cap).
NOTE_EVERY = 600.0

# Two failed heartbeats on the session's own transport trigger recovery. At the
# default cadence this takes about 55 seconds, plus scheduling and shutdown.
# One slow heartbeat is tolerated; an idle remote application is not a failure.
WATCH_EVERY = 20.0
WATCH_FAILS = 2

# A wall clock that outran the monotonic one suggests a suspend on systems whose
# monotonic clock stops during sleep. A large clock adjustment can also trigger
# this check; either way, request fresh evidence that the transport still works.
RESUME_JUMP = 30.0

# Every line is `ssa: <state>: <reason>`, and the longest state clause is
# "waiting for " plus a 20-character host label: 80 - 17 - 20 - 2. A line that
# wraps is the one a full-screen program shreds.
REASON_MAX = 41

EXIT_AMBIGUOUS = 255  # ssh's own "something went wrong", the only status we read
EXIT_INT = 130
EXIT_TERM = 143


class Class(enum.Enum):
    """What ssa does about a failure, as opposed to what it prints."""

    FATAL = "fatal"  # retrying cannot help
    AUTH = "auth"  # credentials refused, possibly locally by a proxy
    CONNECT = "connect"  # no session existed, so retrying is safe
    DROPPED = "dropped"  # nothing matched, so a live session died


@dataclass(frozen=True)
class Rule:
    """One row of the failure table: a decision, a sentence, and a match."""

    cls: Class
    reason: str
    pattern: str


# One table rather than three branches, so a class and its sentence cannot drift
# apart and a new failure mode is one row. First match wins, over the tail only,
# so a proxy's own diagnostic outranks the generic handshake failure under it.
RULES: tuple[Rule, ...] = (
    Rule(Class.FATAL, "host key changed", "IDENTIFICATION HAS CHANGED"),
    Rule(Class.FATAL, "host key not verified", "Host key verification failed"),
    Rule(Class.FATAL, "bad ssh option", "Bad configuration option"),
    Rule(Class.FATAL, "bad ssh option", "illegal option"),
    Rule(Class.FATAL, "bad ssh option", "unknown option"),
    Rule(Class.AUTH, "credentials rejected", "Permission denied"),
    Rule(Class.AUTH, "too many authentication attempts", "Too many authentication failures"),
    Rule(Class.AUTH, "proxy credentials expired", "ExpiredToken"),
    Rule(Class.AUTH, "proxy has no credentials", "Unable to locate credentials"),
    Rule(Class.AUTH, "proxy rejected, refresh AWS credentials", "UnauthorizedRequest"),
    Rule(Class.AUTH, "proxy rejected, refresh AWS credentials", "Server authentication failed"),
    Rule(Class.CONNECT, "unresolved host, check DNS or VPN", "Could not resolve"),
    Rule(Class.CONNECT, "unresolved host, check DNS or VPN", "Name or service not known"),
    Rule(Class.CONNECT, "unresolved host, check DNS or VPN", "nodename nor servname"),
    Rule(Class.CONNECT, "connection refused", "Connection refused"),
    Rule(Class.CONNECT, "connection timed out", "Connection timed out"),
    Rule(Class.CONNECT, "connection timed out", "Operation timed out"),
    Rule(Class.CONNECT, "no route to host", "No route to host"),
    Rule(Class.CONNECT, "network unreachable", "Network is unreachable"),
    Rule(Class.CONNECT, "refused mid-handshake", "exchange_identification"),
)

NO_DIAGNOSTIC = "no diagnostic, so ~. or a silent drop"
WEDGED = "probe timed out, no answer"

# Shared by readiness probes and heartbeats. Their transport options differ:
# readiness requires a fresh connection, a heartbeat must use the owned master.
PROBE_OPTS = (
    "-T",
    "-o", "BatchMode=yes",
    "-o", "ControlMaster=no",
    "-o", "ControlPersist=no",
    "-o", "ClearAllForwardings=yes",
    "-o", "PermitLocalCommand=no",
)  # fmt: skip

USAGE = """\
usage: ssa [--tmux[=NAME]] host [cmd]

  --tmux[=NAME]    attach-or-create remote tmux NAME (default main), so the
                   session survives a reconnect too; implies -t

ssh flags are refused: connection settings belong in ~/.ssh/config, where plain
ssh and ssa's own probe both read them. A supplied remote command is never
replayed after an ambiguous exit; run it under --tmux if it must survive a drop.
It waits forever by design -- ^C stops it. Credentials, VPN and portals are
waited on, never solved for you."""


@dataclass(frozen=True)
class Diagnosis:
    """Why a connection ended: what to do, what to print, and what "changed".

    `key` is the reason with anything that ticks taken out of it, because a cert
    expiry is worded with a duration: comparing `reason` would report a change on
    every probe and defeat the print cadence.
    """

    cls: Class
    reason: str
    key: str

    @classmethod
    def of(cls, failure: Class, reason: str, key: str | None = None) -> Diagnosis:
        return cls(failure, reason, reason if key is None else key)


def duration(seconds: float) -> str:
    """Hours, because "543m21s" is not a duration anyone reads."""
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{seconds // 60 % 60:02d}m"


def tail(stderr: str, lines: int = TAIL_LINES) -> str:
    """The end of stderr, which is the part describing how this session ended."""
    keep = [
        line
        for line in stderr.splitlines()
        if line.strip() and not line.startswith("Warning: Permanently added")
    ]
    return "\n".join(keep[-lines:])


def cap(reason: str) -> str:
    """Hold wording ssh chose, rather than us, to the width budget."""
    return reason if len(reason) <= REASON_MAX else reason[: REASON_MAX - 3] + "..."


def cert_expiry(
    valid_to: str | None, now: float, parse: Callable[[str], float | None]
) -> str | None:
    """Explain a rejected credential from the certificate's own Valid-to.

    A missing certificate is not an answer: reporting one as expired reads
    exactly like the true message and sends you to mwinit for nothing.
    """
    if not valid_to:
        return None
    expiry = parse(valid_to)
    if expiry is None:
        return None
    if now > expiry:
        return f"cert expired {duration(now - expiry)} ago"
    return "credentials rejected, cert is live"


def diagnose(stderr: str, cert_note: Callable[[], str | None] = lambda: None) -> Diagnosis:
    """Map stderr to exactly one decision and one sentence."""
    text = tail(stderr)
    for rule in RULES:
        if rule.pattern in text:
            if rule.reason == "credentials rejected" and (note := cert_note()):
                return Diagnosis.of(rule.cls, note, rule.reason)
            return Diagnosis.of(rule.cls, rule.reason)

    # Unclassified, so ssh's own last line is the reason. A session with a tty
    # ends its lines with CR, which would send the cursor back over our prefix.
    last = ""
    for line in text.splitlines():
        if line.strip():
            last = line
    last = last.replace("\r", "").removeprefix("ssh: ").strip()
    return Diagnosis.of(Class.DROPPED, cap(last) if last else NO_DIAGNOSTIC)


class Refused(Exception):
    """A configuration or argument ssa will not supervise."""


class Helped(Exception):
    """--help was asked for."""


@dataclass(frozen=True)
class Options:
    host: str
    command: tuple[str, ...] = ()
    tmux: str | None = None

    @property
    def label(self) -> str:
        """The first label: an FQDN is most of a line, and a wrapped line is
        one a full-screen program shreds."""
        return self.host.split(".")[0]

    @property
    def remote(self) -> tuple[str, ...]:
        """-A attaches or creates, which is what makes a replay after a drop
        safe. -u because a remote command gets no login shell, so LC_* is POSIX
        and tmux would draw every multibyte cell as "_"."""
        if self.tmux is not None:
            return ("tmux", "-u", "new", "-A", "-s", self.tmux)
        return self.command


def parse(argv: Sequence[str]) -> Options:
    """One left-to-right pass: only tokens before the hostname are ours.

    Hand-rolled rather than argparse for one reason -- `--tmux` must not consume
    the token after it, since `ssa --tmux gpu2` names a host, not a session.
    SSH flags are refused; host connection settings belong in ssh_config, which
    both the session and readiness probes read.
    """
    tmux: str | None = None
    for index, token in enumerate(argv):
        if token == "--help":
            raise Helped
        if token == "--tmux":
            tmux = "main"
        elif token.startswith("--tmux="):
            tmux = token.split("=", 1)[1]
        elif token.startswith("--"):
            raise Refused(f"unknown option {token}")
        elif token.startswith("-"):
            raise Refused(
                f"no ssh flags: put {token} in ~/.ssh/config, where the probe reads it too"
            )
        else:
            command = tuple(argv[index + 1 :])  # ssh's to interpret, not ours
            if tmux is not None and command:
                raise Refused("--tmux replaces the remote command; use --tmux=NAME")
            return Options(host=token, command=command, tmux=tmux)
    raise Refused("no host given")


def keepalive_refusal(host: str) -> str:
    return (
        f"{host} has no ServerAliveInterval; configure ssh's own dead-link detector.\n"
        "    Add to ~/.ssh/config:\n"
        f"        Host {host}\n"
        "            ServerAliveInterval 15\n"
        "            ServerAliveCountMax 3"
    )


def probe_resets(config: str) -> tuple[str, ...]:
    """Reset only what `ssh -G` advertised: either option would suppress the
    probe's finite `true`, and a client that does not know the name rejects it."""
    resets: list[str] = []
    if re.search(r"^remotecommand ", config, re.MULTILINE):
        resets += ["-o", "RemoteCommand=none"]
    if re.search(r"^sessiontype ", config, re.MULTILINE):
        resets += ["-o", "SessionType=default"]
    return tuple(resets)


def render(reason: str) -> str:
    return f"{PROG}: {reason}"
@dataclass
class Reporter:
    """Status lines: one on entry, one per change of reason, else one per
    NOTE_EVERY. It was the repetition that made this loop unreadable."""

    clock: Callable[[], float] = time.monotonic
    stream: object = sys.stderr
    last: str | None = field(default=None, init=False)
    noted: float = field(default=0.0, init=False)

    def say(self, message: str) -> None:
        print(render(message), file=self.stream, flush=True)

    def waiting(self, label: str, why: Diagnosis) -> None:
        self.say(f"waiting for {label}: {why.reason}")
        self.last, self.noted = why.key, self.clock()

    def still(self, waited: float, why: Diagnosis) -> None:
        if why.key != self.last or self.clock() - self.noted >= NOTE_EVERY:
            self.say(f"still waiting after {duration(waited)}: {why.reason}")
            self.last, self.noted = why.key, self.clock()

    def back(self, label: str, waited: float) -> None:
        if waited > 30:  # long enough that nobody was watching
            print("\a", end="", file=self.stream, flush=True)
        self.say(f"{label} back after {duration(waited)}, reconnecting")


def portal(run: Callable[[list[str]], tuple[int, str]]) -> str | None:
    """Is something answering *for* the network? Reported, never signed into."""
    code, out = run(
        [
            "curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "5",
            "http://connectivitycheck.gstatic.com/generate_204",
        ]
    )  # fmt: skip
    out = out.strip()
    if code == 0 and out and out not in {"204", "000"}:
        return f"captive portal, HTTP {out} -- sign in from a browser"
    return None


def grace(seconds: float = GRACE) -> bool:
    """A keypress window before reconnecting, and the key is *named*: a dying
    full-screen program leaves escape bytes in the input queue, and those are not
    someone asking to stop."""
    if not sys.stdin.isatty():
        return True
    print(f"{PROG}: reconnecting in {seconds:.0f}s, q to stop", end="", file=sys.stderr, flush=True)
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        deadline = time.monotonic() + seconds
        while (left := deadline - time.monotonic()) > 0:
            if select.select([fd], [], [], left)[0] and os.read(fd, 1) == b"q":
                return False
        return True
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        print(file=sys.stderr, flush=True)


def _kill_group(proc: subprocess.Popen) -> None:
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        proc.kill()


@dataclass
class Ssh:
    """Connection settings shared by fresh attempts and transport heartbeats."""

    host: str
    resets: tuple[str, ...] = ()
    foreground: tuple[str, ...] = ()
    connect_timeout: int = PROBE_CONNECT
    current: subprocess.Popen | None = field(default=None, init=False, repr=False)

    @property
    def connect_wall(self) -> float:
        # A configured slow handshake (notably SSM) must also work in the
        # readiness probe. Leave time after it for authentication and `true`.
        return max(CONNECT_WALL, self.connect_timeout + PROBE_WALL)

    def config(self) -> str:
        status, output = self._bounded(["ssh", "-G", self.host], capture_stdout=True)
        if status == 124:
            raise Refused("ssh configuration lookup timed out")
        if status != 0:
            raise Refused(f"cannot read ssh configuration: {cap(tail(output))}")
        self.resets = probe_resets(output)
        if re.search(r"^forkafterauthentication ", output, re.MULTILINE):
            self.foreground = ("-o", "ForkAfterAuthentication=no")
        timeout = re.search(r"^connecttimeout (\d+)", output, re.MULTILINE)
        if timeout and int(timeout.group(1)) > 0:
            self.connect_timeout = int(timeout.group(1))
        return output

    def probe_argv(self, control_path: str | None = None) -> list[str]:
        if control_path is None:
            transport = ["-o", "ControlPath=none"]
        else:
            # ControlMaster=no alone is NOT mux-only: OpenSSH falls back to a
            # new connection on a missing socket or rejected channel. A failed
            # fallback must never authenticate or certify a different transport.
            # ProxyCommand on the command line also takes precedence over a
            # configured ProxyJump. See OpenSSH's readconf.c and mux.c.
            transport = ["-S", control_path, "-o", "ProxyCommand=false"]
        return [
            "ssh", *PROBE_OPTS, "-o", f"ConnectTimeout={self.connect_timeout}",
            *transport, *self.resets, *self.foreground, self.host, "true",
        ]

    def probe(self) -> tuple[int, str]:
        """Try a fresh connection, as the next supervised session will do."""
        return self._bounded(self.probe_argv(), timeout=self.connect_wall)

    def stop(self) -> None:
        """^C should not wait out a probe's bound."""
        if self.current is not None and self.current.poll() is None:
            _kill_group(self.current)

    def _bounded(
        self, argv: list[str], *, timeout: float | None = None, capture_stdout: bool = False
    ) -> tuple[int, str]:
        """Run argv under a wall clock, and wait on the *process*.

        stderr goes to a file, not a pipe: a ProxyCommand child inherits it and
        killing does not reach that child, so waiting for EOF would wait for the
        grandchild. A file has no EOF to hold hostage.
        """
        if timeout is None:
            timeout = PROBE_WALL
        with tempfile.TemporaryFile() as errors:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=errors if capture_stdout else subprocess.DEVNULL,
                stderr=errors,
                start_new_session=True,
            )
            self.current = proc
            try:
                status = proc.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                _kill_group(proc)
                proc.wait()
                status = 124
            finally:
                # Also clean up when a signal interrupts the wait.
                if proc.poll() is None:
                    _kill_group(proc)
                proc.wait()
                self.current = None
            errors.seek(0)
            return status, errors.read().decode("utf-8", "replace")


@dataclass
class Watchdog:
    """Run `true` over the exact transport carrying the interactive session.

    A local `ssh -O check` only establishes that a master process answers; a new
    connection only establishes that a new connection works. Neither establishes
    that this connection can pass traffic. The private socket binds our heartbeat
    to this attempt, even on hosts with multiplexing disabled in ssh_config.
    """

    ssh: Ssh
    control_path: str = ""
    clock: Callable[[], float] = time.monotonic
    wall: Callable[[], float] = time.time
    due: float | None = field(default=None, init=False)
    started: float | None = field(default=None, init=False)
    connected: bool = field(default=False, init=False)
    seen: tuple[float, float] | None = field(default=None, init=False)
    proc: subprocess.Popen | None = field(default=None, init=False, repr=False)
    errors: object = field(default=None, init=False, repr=False)
    deadline: float = field(default=0.0, init=False)
    fails: int = field(default=0, init=False)

    def tick(self) -> Diagnosis | None:
        """Advance the monitor; a Diagnosis means the link is dead."""
        now = self.clock()
        wall = self.wall()
        if self.started is None:
            self.started = now
            self.due = now + WATCH_EVERY
        if self.seen is not None:
            slept = (wall - self.seen[1]) - (now - self.seen[0])
            if slept > RESUME_JUMP:
                self.due = now
                self.deadline = now  # an in-flight heartbeat is stale too
                self.started -= slept
        self.seen = (now, wall)
        if not self.connected:
            # Popen is not proof of authentication. The owned master starts
            # listening after authentication; don't count a slow SSM startup as
            # two failed heartbeats, and don't wait forever if it never starts.
            if os.path.exists(self.control_path):
                self.connected = True
            elif now - self.started >= self.ssh.connect_wall:
                return Diagnosis.of(Class.CONNECT, "connection setup timed out")
            else:
                return None
        if self.proc is None:
            if self.due is not None and now >= self.due:
                self._start(now)
            return None
        status = self.proc.poll()
        if status is None:
            if now < self.deadline:
                return None
            _kill_group(self.proc)
            self.proc.wait()
            status = 124
        return self._collect(status, now)

    def _start(self, now: float) -> None:
        # Not a context manager on purpose: the file outlives this call, read
        # and closed by _collect on a later tick, or by stop.
        self.errors = tempfile.TemporaryFile()  # noqa: SIM115
        self.proc = subprocess.Popen(
            self.ssh.probe_argv(self.control_path),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=self.errors,
            start_new_session=True,
        )
        self.deadline = now + PROBE_WALL
        self.due = now + WATCH_EVERY

    def _collect(self, status: int, now: float) -> Diagnosis | None:
        self.errors.seek(0)
        stderr = self.errors.read().decode("utf-8", "replace")
        self.errors.close()
        self.errors = None
        self.proc = None
        if status == 0:
            self.fails = 0
            return None
        why = diagnose(stderr)
        if status == 124:
            why = Diagnosis.of(why.cls, WEDGED)
        # Every nonzero result failed to complete the heartbeat. In particular,
        # "Connection reset", "Broken pipe", and an empty stderr count too.
        # No fresh authentication happens on this transport, so expiring local
        # credentials cannot by themselves kill an established session.
        self.fails += 1
        if self.fails >= WATCH_FAILS:
            return why
        return None

    def stop(self) -> None:
        """Stop and reap the heartbeat, whoever is stopping the session."""
        if self.proc is not None and self.proc.poll() is None:
            _kill_group(self.proc)
            self.proc.wait()
        if self.errors is not None:
            self.errors.close()
            self.errors = None
        self.proc = None


@dataclass
class Session:
    """One supervised ssh on our own terminal."""

    options: Options
    watch: Watchdog | None = None
    proc: subprocess.Popen | None = field(default=None, init=False, repr=False)
    why: Diagnosis | None = field(default=None, init=False)

    def argv(self, control_path: str) -> list[str]:
        argv = [
            "ssh", "-o", "BatchMode=yes", "-o", "ControlMaster=yes",
            "-o", "ControlPersist=no", "-S", control_path,
        ]
        if self.watch is not None:
            argv.extend(self.watch.ssh.foreground)
        if self.options.tmux is not None:
            argv.append("-t")
        return [*argv, self.options.host, *self.options.remote]

    def run(self) -> tuple[int, str]:
        # /tmp keeps the Unix socket below sun_path's length limit on macOS too.
        # A new 0700 directory per attempt also keeps unrelated SSH sessions out
        # of recovery: no check/exit against the user's shared control socket.
        with tempfile.TemporaryDirectory(prefix="ssa-", dir="/tmp") as directory:
            control_path = os.path.join(directory, "master")
            if self.watch is not None:
                self.watch.control_path = control_path
            saved = termios.tcgetattr(sys.stdin.fileno()) if sys.stdin.isatty() else None
            try:
                return self._run(control_path)
            finally:
                # SIGKILL cannot let ssh restore raw mode. Keep the caller's
                # terminal usable even when the graceful shutdown times out.
                if saved is not None:
                    termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, saved)

    def _run(self, control_path: str) -> tuple[int, str]:
        """Stream stderr through, and keep its tail to classify the failure.

        The drain is bounded by ssh's exit plus DRAIN, because a ProxyCommand
        grandchild inherits the pipe and reading to EOF would wait for it.
        select rather than a reader thread: a thread blocked in readline() holds
        the pipe's lock, and closing the pipe then waits for that lock -- the
        same wait reintroduced as a deadlock.
        """
        chunks: deque[str] = deque(maxlen=64)
        proc = subprocess.Popen(self.argv(control_path), stderr=subprocess.PIPE, bufsize=0)
        self.proc = proc
        assert proc.stderr is not None
        fd = proc.stderr.fileno()
        status: int | None = None
        deadline = 0.0
        reading = True
        try:
            while True:
                # Poll on every iteration, including when stderr is continuously
                # readable. A noisy descendant must not postpone the drain bound.
                if status is None:
                    status = proc.poll()
                    if status is not None:
                        deadline = time.monotonic() + DRAIN
                if status is not None and (not reading or time.monotonic() >= deadline):
                    break
                if (
                    self.watch is not None
                    and status is None
                    and self.why is None
                    and (why := self.watch.tick()) is not None
                ):
                    # The link is dead and ssh has not noticed; end the
                    # session ourselves so the wait loop can take over.
                    self.why = why
                    self.stop()
                    continue
                if select.select([fd] if reading else [], [], [], 0.1)[0]:
                    try:
                        chunk = os.read(fd, 65536)
                    except OSError:
                        chunk = b""
                    if not chunk:
                        # stderr can close long before ssh exits. Keep watching
                        # the process without busy-spinning on the EOF fd.
                        reading = False
                        continue
                    sys.stderr.buffer.write(chunk)
                    sys.stderr.buffer.flush()
                    chunks.append(chunk.decode("utf-8", "replace"))
        finally:
            if self.watch is not None:
                self.watch.stop()
            proc.stderr.close()
            if proc.poll() is None:
                self.stop()
            status = proc.wait()
            self.proc = None
        return status, "".join(chunks)

    def stop(self) -> None:
        if self.watch is not None:
            self.watch.stop()
        proc = self.proc
        if proc is None:
            return
        # CONT first: a stopped child leaves TERM pending, so it would be killed
        # without ever restoring the terminal.
        for sig in (signal.SIGCONT, signal.SIGTERM):
            try:
                proc.send_signal(sig)
            except ProcessLookupError:
                return
        try:
            proc.wait(timeout=DRAIN)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


@dataclass
class Supervisor:
    """The reconnect loop. It waits forever: a credential that will be
    refreshed, a VPN that will come back and a closed laptop are all indefinite,
    so ^C is the bound that means anything and every call has its own."""

    options: Options
    ssh: Ssh
    report: Reporter
    clock: Callable[[], float] = time.monotonic
    sleep: Callable[[float], None] = time.sleep
    delays: Iterable[float] | None = None
    cert: str = CERT
    session: Session | None = field(default=None, init=False, repr=False)

    def diagnose(self, stderr: str) -> Diagnosis:
        return diagnose(stderr, self._cert_note)

    def _cert_note(self) -> str | None:
        done = subprocess.run(
            ["ssh-keygen", "-L", "-f", os.path.expanduser(self.cert)],
            capture_output=True,
            text=True,
            check=False,
        )
        found = re.search(r"Valid: from \S+ to (\S+)", done.stdout)
        return cert_expiry(found.group(1) if found else None, time.time(), _parse_date)

    def run(self) -> int:
        while True:
            self.session = Session(self.options, watch=Watchdog(ssh=self.ssh))
            status, stderr = self.session.run()
            killed = self.session.why
            self.session = None

            if killed is not None:
                # The watchdog ended the session, so the status is the kill's,
                # not the remote command's, and `~.` is ruled out: no grace.
                why = killed
                self.report.say(f"link dead: {why.reason}")
            else:
                if status != EXIT_AMBIGUOUS:  # definitely the remote command's
                    return status
                why = self.diagnose(stderr)

            if why.cls is Class.FATAL:
                if why.reason == "host key changed":
                    self.report.say(
                        "a rebuilt host and a MITM look the same here; verify, then fix known_hosts"
                    )
                self.report.say(f"not reconnecting: {why.reason}")
                return EXIT_AMBIGUOUS

            # Remote stderr shares this stream, and a remote command may itself
            # return 255. No wording can prove it never started, so it is never
            # replayed; tmux is exempt because it is our own idempotent command.
            if self.options.command:
                cause = "link dead" if killed is not None else "ssh exited 255"
                self.report.say(
                    f"{cause} and '{' '.join(self.options.command)}' may have run; "
                    "run it under --tmux to survive a drop"
                )
                return EXIT_AMBIGUOUS

            if killed is None and why.cls is Class.DROPPED and not grace():
                return EXIT_AMBIGUOUS

            self.report.back(self.options.label, self.wait(why))

    def wait(self, why: Diagnosis) -> float:
        """Probe until the session would connect, reporting what we wait for."""
        start = self.clock()
        self.report.waiting(self.options.label, why)
        for delay in self.delays if self.delays is not None else _backoff():
            status, stderr = self.ssh.probe()
            if status == 0:
                return self.clock() - start

            why = self.diagnose(stderr)
            if status == 124:
                # A killed probe wrote at most a fragment of a handshake, so the
                # kill is the fact worth reporting.
                why = Diagnosis.of(why.cls, WEDGED)
            if why.cls is Class.FATAL:
                # A host rebuilt during the outage we are sitting out is the
                # ordinary way a key changes mid-wait.
                self.report.say(f"not reconnecting: {why.reason}")
                raise SystemExit(EXIT_AMBIGUOUS)
            if why.cls is Class.CONNECT and (spotted := portal(_run)):
                # A portal leaves the failure it hides unchanged, so it has to
                # refine the reason before the cadence compares it.
                why = Diagnosis.of(why.cls, spotted)

            self.report.still(self.clock() - start, why)
            self.sleep(delay)
        return self.clock() - start

    def stop(self, status: int) -> None:
        if self.session is not None:
            self.session.stop()
        self.ssh.stop()
        raise SystemExit(status)


def _backoff(cap_at: float = MAX_DELAY) -> Iterable[float]:
    delay = 1.0
    while True:
        yield delay
        delay = min(delay * 2, cap_at)


def _run(argv: list[str]) -> tuple[int, str]:
    try:
        done = subprocess.run(argv, capture_output=True, text=True, check=False, timeout=PROBE_WALL)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return 1, ""
    return done.returncode, done.stdout


def _parse_date(value: str) -> float | None:
    from datetime import datetime

    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
        try:
            # ssh-keygen prints a naive local timestamp, so it is read as one.
            return datetime.strptime(value, fmt).timestamp()  # noqa: DTZ007
        except ValueError:
            continue
    return None


def main(argv: Sequence[str] | None = None) -> int:
    report = Reporter()
    try:
        options = parse(list(sys.argv[1:] if argv is None else argv))
    except Helped:
        print(USAGE)
        return 0
    except Refused as refused:
        report.say(str(refused))
        return EXIT_AMBIGUOUS

    if shutil.which("ssh") is None:
        report.say("needs ssh")
        return EXIT_AMBIGUOUS

    ssh = Ssh(options.host)
    supervisor = Supervisor(options=options, ssh=ssh, report=report)
    signal.signal(signal.SIGINT, lambda *_: supervisor.stop(EXIT_INT))
    signal.signal(signal.SIGTERM, lambda *_: supervisor.stop(EXIT_TERM))
    try:
        config = ssh.config()
        interval = re.search(r"^serveraliveinterval (\d+)", config, re.MULTILINE)
        if interval and interval.group(1) == "0":
            report.say(keepalive_refusal(options.host))
            return EXIT_AMBIGUOUS
        return supervisor.run()
    except Refused as refused:
        report.say(str(refused))
        return EXIT_AMBIGUOUS
    except SystemExit as exit_:
        return int(exit_.code or 0)
    except KeyboardInterrupt:
        return EXIT_INT


if __name__ == "__main__":
    sys.exit(main())
