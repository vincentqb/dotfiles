#!/usr/bin/env bash
# ssa -- ssh that waits out a broken network and reconnects. It never blocks on
# an SSH prompt: it reports what it is waiting for and retries on the next probe.
# The properties it maintains, and the check that discharges each: README.md.

set -uo pipefail

PROG=${0##*/}
# ssh short options that take an argument (OpenSSH 7.4 synopsis).
ARGOPTS='bcDEeFIiJLlmOopQRSWw'
# Options that change what a session does rather than how it connects, or that
# silence the stream `diagnose` reads. A probe must run `true`, finish, and explain
# itself, so these are omitted from its copy of argv.
PROBE_SKIP='MNqstT'
PROBE_SKIP_ARGOPTS='EOQW'
# bash 4.2: "${a[@]}" on an empty array dies under set -u, hence ${a[@]+...}.

# Constants, not options. Each of these was a knob nobody ever turned, and an
# option is a thing to get wrong at 2am on a broken link.
GRACE=3           # keypress window before a reconnect, so `~.` can stop it
PROBE_CONNECT=7   # a probe's ConnectTimeout: bounds a fresh handshake
PROBE_WALL=15     # hard kill for any ssh we start. ConnectTimeout does not apply
                  # to a connection handed to a live control master, and -O check
                  # has no bound of its own at all, so without this a "probe" can
                  # sit inside a wedged master for that master's whole keepalive.
MAX_DELAY=60      # longest gap between probes
DRAIN=1           # grace for ssh's stderr to reach us after ssh itself has exited
# How much of stderr describes how *this* session ended. The deepest real
# transcript is two lines -- a proxy's own diagnostic, and the handshake failure
# ssh reports underneath it -- plus one of slack. Reading the whole stream instead
# diagnoses today's failure from a line left by an attempt that then recovered.
TAIL_LINES=3
# A line per probe reads fine for a 30-second outage and is unusable for a night
# one: nine hours at the MAX_DELAY cap is ~540 lines of the same sentence. So the
# probe cadence and the *print* cadence are separate -- probes back off to
# MAX_DELAY, prints happen on a change of reason and otherwise once per note_every.
note_every=${SSA_NOTE_EVERY:-600}
cert=${SSA_CERT:-$HOME/.ssh/id_rsa-cert.pub}
max_wait=0
tmux_session=
# Every status line is `ssa: <state>: <reason>`. The longest state clause is
# "waiting for " plus a host label, so 80 - len("ssa: waiting for ") - 20 - len(": ")
# is what a reason may occupy; capping one ssh worded itself is what keeps the
# whole line inside 80 columns, and a line that wraps is the one a full-screen
# program shreds. test-ssa recomputes this bound and holds the table to it.
REASON_MAX=41

usage() {
    cat <<'EOF'
usage: ssa [--tmux[=NAME]] [--max-wait=SECS] [ssh args] host [cmd]

  --tmux[=NAME]    attach-or-create remote tmux NAME (default main), so the
                   session survives a reconnect too; implies -t
  --max-wait=SECS  give up on one reconnect after SECS (0 = never)

A supplied remote command is never replayed after an ambiguous exit; run it
inside --tmux if it has to survive a drop.
Credentials, VPN and portals are waited on, never solved for you.
EOF
}

say() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { say "$*"; exit 255; }
now() { date +%s; }
# Hours, because an overnight wait is the case the print cadence exists for and
# "543m21s" is not a duration anyone reads. Seconds stop mattering at that scale.
dur() {
    if (($1 < 60)); then printf '%ds' "$1"
    elif (($1 < 3600)); then printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
    else printf '%dh%02dm' $(($1 / 3600)) $(($1 / 60 % 60)); fi
}

# One left-to-right pass: our long options and a remote command can be spelled
# the same, so only tokens before the hostname are ours. probe_opts is the same
# connection with session-only flags removed; unlike -N, its `true` must finish.
ssh_opts=()
probe_opts=()
user_cmd=()
host=
argv=("$@")
i=0
while ((i < ${#argv[@]})); do
    a=${argv[i]}
    case $a in
        --help) usage; exit 0 ;;
        --tmux) tmux_session=main ;;
        --tmux=*) tmux_session=${a#*=} ;;
        --max-wait=*) max_wait=${a#*=} ;;
        --*) die "unknown option $a" ;;
        -?*)
            ssh_opts+=("$a")
            probe_a=-
            # Consume the next token only if an argument-taking flag ends the
            # cluster: -p22, -p 22 and -tp 22 are all legal.
            r=${a#-}
            while [[ -n $r && $ARGOPTS != *"${r:0:1}"* ]]; do
                c=${r:0:1}
                # -f backgrounds ssh, which returns 0 at once and leaves nothing
                # to supervise. Only the no-argument prefix of a cluster is
                # examined, so -F and an -i path are not mistaken for it.
                [[ $c == f ]] &&
                    die "-f backgrounds ssh; background $PROG instead"
                [[ $PROBE_SKIP != *"$c"* ]] && probe_a+=$c
                r=${r:1}
            done
            skip_probe_arg=0
            if [[ -n $r ]]; then
                [[ $PROBE_SKIP_ARGOPTS == *"${r:0:1}"* ]] && skip_probe_arg=1
                ((skip_probe_arg)) || probe_a+=$r
            fi
            [[ $probe_a == - ]] || probe_opts+=("$probe_a")
            if [[ -n $r && -z ${r:1} ]]; then
                ((++i < ${#argv[@]})) || die "option $a needs an argument"
                ssh_opts+=("${argv[i]}")
                ((skip_probe_arg)) || probe_opts+=("${argv[i]}")
            fi
            ;;
        # Quoted: the remote command is ssh's to interpret, not ours to glob.
        *) host=$a; user_cmd=("${argv[@]:i+1}"); break ;;
    esac
    ((i++))
done
[[ -n $host ]] || { usage >&2; die 'no host given'; }
# A bound bash reads as 0 is worse than no bound: --max-wait=1O (letter O) would
# silently mean "wait forever", which is the opposite of what was asked for. Only
# --max-wait may be 0; a keep-alive interval of 0 prints on every probe, which is
# the wall of text the two clocks exist to prevent.
[[ $max_wait =~ ^(0|[1-9][0-9]*)$ ]] || die "expected whole seconds, got '$max_wait'"
[[ $note_every =~ ^[1-9][0-9]*$ ]] ||
    die "SSA_NOTE_EVERY wants whole seconds above zero, got '$note_every'"
# Bounding a probe needs a clock we did not write. coreutils on Linux, brew or
# MacPorts coreutils on a mac, where the same binary is installed as gtimeout.
timeout_bin=$(command -v timeout || command -v gtimeout) ||
    die 'needs timeout(1) from coreutils to bound a probe'
# Messages name the host by its first label. The FQDN of a dev desktop is 50
# characters, which is most of a line on its own, and every line that wraps is
# a line that gets shredded by whatever full-screen program shares the terminal.
short_host=${host%%.*}

# autossh's -M monitor exists because nothing reconnects if nothing notices the
# link died. ssh's ServerAliveInterval is that check, and its default is 0: on a
# dead link ssh blocks until the kernel gives up, so there is nothing to
# supervise and this whole script does nothing. Refuse rather than inject one --
# it belongs in ssh_config, where plain ssh benefits too, and a wrapper quietly
# rewriting connection parameters is worse than being told once.
ssh_config=$(ssh -G ${ssh_opts[@]+"${ssh_opts[@]}"} "$host" 2>/dev/null)
[[ $(awk '$1 == "serveraliveinterval" { print $2; exit }' <<<"$ssh_config") == 0 ]] &&
    die "$host has no ServerAliveInterval, so ssh will never notice a dead link.
    Add to ~/.ssh/config:
        Host $host
            ServerAliveInterval 15
            ServerAliveCountMax 3"

# Newer clients can inherit RemoteCommand or SessionType from ssh_config. Both
# conflict with the probe's finite `true`; only pass their reset on clients that
# advertised the option, because OpenSSH 7.4 rejects both names.
probe_compat=()
grep -q '^remotecommand ' <<<"$ssh_config" && probe_compat+=(-o RemoteCommand=none)
grep -q '^sessiontype ' <<<"$ssh_config" && probe_compat+=(-o SessionType=default)

eff_cmd=(${user_cmd[@]+"${user_cmd[@]}"})
if [[ -n $tmux_session ]]; then
    ((${#user_cmd[@]} == 0)) || die "--tmux replaces the remote command; use --tmux=NAME"
    # -A attaches or creates. -u because a remote command gets no login shell,
    # so LC_* is POSIX and tmux would draw every multibyte cell as "_"; the
    # same session entered by hand looks fine, which makes it look like our bug.
    eff_cmd=(tmux -u new -A -s "$tmux_session")
fi

# Every failure ssh, or a ProxyCommand standing in for the network, can report:
# the class that decides what we do, the clause we print, and the substring that
# identifies it. One table rather than three case statements, so a class and a
# reason cannot drift apart and a new failure mode is one row, not three edits.
#
# fatal: retrying cannot help. auth: credentials refused; the host is reachable.
# connect: no session existed, so retrying an interactive connection is safe.
# dropped (no row matched): one died. A supplied remote command is ambiguous
# whatever the text says, because its stderr is this same stream and it may
# itself return 255; that policy is enforced in the loop, not here.
#
# The first matching row wins and the whole of stderr is searched, so a proxy's
# own diagnostic outranks the generic handshake failure ssh reports underneath it.
FAILURES='fatal|host key changed|IDENTIFICATION HAS CHANGED
fatal|host key not verified|Host key verification failed
fatal|bad ssh option|Bad configuration option
fatal|bad ssh option|illegal option
fatal|bad ssh option|unknown option
auth|credentials rejected|Permission denied
auth|too many authentication attempts|Too many authentication failures
auth|proxy credentials expired|ExpiredToken
auth|proxy has no credentials|Unable to locate credentials
auth|proxy rejected, refresh AWS credentials|UnauthorizedRequest
auth|proxy rejected, refresh AWS credentials|Server authentication failed
connect|unresolved host, check DNS or VPN|Could not resolve
connect|unresolved host, check DNS or VPN|Name or service not known
connect|unresolved host, check DNS or VPN|nodename nor servname
connect|connection refused|Connection refused
connect|connection timed out|Connection timed out
connect|connection timed out|Operation timed out
connect|no route to host|No route to host
connect|network unreachable|Network is unreachable
connect|refused mid-handshake|exchange_identification'

# "Permission denied" does not say why. The certificate's own Valid-to does, so
# when it can answer it answers for the whole line -- and the host may not use this
# certificate at all, which is what the second branch reports.
cert_reason() {
    local to exp
    to=$(ssh-keygen -L -f "$cert" 2>/dev/null | sed -n 's/.*Valid: from .* to \([^ ]*\).*/\1/p')
    # No certificate to read is not an answer. Without this, `date -d ''` succeeds
    # and returns midnight today, so an unreadable cert was reported as expired --
    # a false reason that reads exactly like the true one, and sends you to mwinit.
    [[ -n $to ]] || return 1
    exp=$(date -d "$to" +%s 2>/dev/null || date -j -f '%Y-%m-%dT%H:%M:%S' "$to" +%s 2>/dev/null) ||
        return 1
    if (($(now) > exp)); then printf 'cert expired %s ago' "$(dur $(($(now) - exp)))"
    else printf 'credentials rejected, cert is live'; fi
}

# The end of stderr, which is the part that describes how *this* session ended. A
# session accumulates its remote command's stderr, and a host with
# StrictHostKeyChecking off warns on every single connect, so reading the whole
# stream lets a line from an attempt that then recovered classify the failure that
# actually stopped us. First match still wins by row, because a proxy writes its
# own diagnostic *before* the handshake failure ssh reports underneath it.
tail_err() {
    awk -v k="$TAIL_LINES" '!/^Warning: Permanently added/ && NF { l[++n] = $0 }
        END { for (i = n - k + 1; i <= n; i++) if (i > 0) print l[i] }' <<<"$1"
}

# The one place stderr becomes a decision and a sentence, so the two agree by
# construction. Sets CLASS, REASON, and KEY -- the reason with anything that ticks
# taken out of it. A cert expiry is worded with a duration that grows between
# probes, so comparing REASON would report a change on every probe and defeat the
# print cadence entirely; KEY is what "has the reason changed?" means.
CLASS=
REASON=
KEY=
diagnose() {
    local class phrase pat answer text
    text=$(tail_err "$1")
    while IFS='|' read -r class phrase pat; do
        [[ $text == *"$pat"* ]] || continue
        CLASS=$class REASON=$phrase KEY=$phrase
        [[ $phrase == 'credentials rejected' ]] && answer=$(cert_reason) && REASON=$answer
        return
    done <<<"$FAILURES"
    # Unclassified, so ssh's own last line is the reason, capped to one line. ssh
    # writes it to this terminal unabridged either way. A session with a tty ends
    # its lines with CR, which would send the cursor back over our own prefix.
    CLASS=dropped
    REASON=$(awk 'NF { l = $0 }
        END { gsub(/\r/, "", l); sub(/^ssh: /, "", l); print l }' <<<"$text")
    ((${#REASON} > REASON_MAX)) && REASON=${REASON:0:REASON_MAX-3}...
    REASON=${REASON:-'no diagnostic, so ~. or a silent drop'}
    KEY=$REASON
}

# One wall clock over a whole reconnect attempt. Every external call is bounded by
# its own cap *and* by whatever is left of --max-wait, because checking the bound
# only after a call returns is not a bound: measured before this, --max-wait=1
# exited after 3s on a slow probe and after 4s on a control socket that would not
# answer. A cap that has already been spent fails the call rather than running it.
deadline=0
bounded() { # bounded CAP cmd...
    local t=$1 left
    shift
    if ((max_wait > 0)); then
        left=$((deadline - $(now)))
        ((left < t)) && t=$left
    fi
    ((t > 0)) || return 124
    "$timeout_bin" "$t" "$@"
}

# The one connection failure waiting never fixes, so it is worth its own probe.
portal() {
    local code
    code=$(bounded 5 curl -sS -o /dev/null -w '%{http_code}' \
        http://connectivitycheck.gstatic.com/generate_204 2>/dev/null)
    [[ -n $code && $code != 204 && $code != 000 ]] &&
        printf 'captive portal, HTTP %s -- sign in from a browser' "$code"
}

# A real ssh, so aliases, ports, ProxyJump and multiplexing all hold. A probe
# answers one question -- would the session connect? -- so it may bound the
# attempt and make it finite, and may not change how the connection is made.
# In particular it keeps the session's ControlPath: reaching a live master is how
# the session will reconnect, and a probe that insists on a fresh handshake would
# wait for credentials the session does not need. Our -o values win because ssh
# keeps the first value it obtains.
probe_err=
probe_rc=0
probe() {
    # stderr to a file, not a pipe: `timeout` kills the ssh it started, not a
    # descendant of it, and a `$(...)` capture waits for the write end to close
    # rather than for the process to die -- so one surviving ProxyCommand child
    # keeps a probe running long after its bound (T13). A file has no EOF to hold
    # hostage, and everything ssh wrote is there when the call returns.
    bounded "$PROBE_WALL" ssh -T -o BatchMode=yes \
        -o ConnectTimeout="$PROBE_CONNECT" \
        -o ControlMaster=no -o ClearAllForwardings=yes \
        ${probe_compat[@]+"${probe_compat[@]}"} \
        ${probe_opts[@]+"${probe_opts[@]}"} "$host" true >/dev/null 2>"$tmpdir/probe"
    probe_rc=$?
    probe_err=$(<"$tmpdir/probe")
    return "$probe_rc"
}

# A master that died with the link leaves a socket that fails the next connect
# instantly. Runs before the probe, so the probe reaches a live master or none.
# No-op when multiplexing is off.
stale_master() {
    bounded "$PROBE_WALL" ssh ${ssh_opts[@]+"${ssh_opts[@]}"} -O check "$host" >/dev/null 2>&1 ||
        bounded "$PROBE_WALL" ssh ${ssh_opts[@]+"${ssh_opts[@]}"} -O exit "$host" >/dev/null 2>&1 ||
        true
}

WAITED=0
# Entered with CLASS and REASON already describing why the session ended. One
# line on entry, then a line only when the reason *changes* -- DNS gave way to
# refused, a portal appeared -- or when note_every has passed. `last` is seeded
# from the entry reason so the first probe does not immediately repeat it. It was
# the repetition that made this loop unreadable, not the waiting.
wait_for() {
    local delay=1 start last last_note spotted wedged
    start=$(now)
    deadline=$((start + max_wait))
    last_note=$start
    last=$KEY
    say "waiting for $short_host: $REASON"
    # Before the first probe, so a probe reaches a live master or none -- and
    # inside the budget, because -O check on a master that has stopped answering
    # has no bound of its own.
    stale_master
    while ! probe; do
        WAITED=$(($(now) - start))
        ((max_wait > 0 && WAITED >= max_wait)) && return 1
        diagnose "$probe_err"
        # A probe we had to kill wrote at most a fragment of a handshake, so the
        # kill is the fact worth reporting rather than the fragment.
        if ((probe_rc == 124)); then
            wedged='probe timed out, no answer'
            REASON=$wedged KEY=$wedged
        fi
        # Waiting cannot fix a fatal reason, whoever noticed it first. A host key
        # can change while we wait -- a host rebuilt during the outage we are
        # sitting out is the ordinary way that happens.
        [[ $CLASS == fatal ]] && die "not reconnecting: $REASON"
        # A portal keeps the connection failure it hides unchanged, so it has to
        # refine the reason before the comparison below, or it would be silent
        # until the next keep-alive line.
        [[ $CLASS == connect ]] && spotted=$(portal) && REASON=$spotted KEY=$spotted
        if [[ $KEY != "$last" ]] || (($(now) - last_note >= note_every)); then
            say "still waiting after $(dur "$WAITED"): $REASON"
            last=$KEY
            last_note=$(now)
        fi
        # Never sleep past --max-wait. The bound is checked before sleeping, so
        # a 60 s cap would otherwise overshoot it by most of a minute.
        WAITED=$(($(now) - start))
        ((max_wait > 0 && WAITED + delay > max_wait)) &&
            delay=$((max_wait - WAITED > 1 ? max_wait - WAITED : 1))
        sleep "$delay"
        ((delay = delay * 2 > MAX_DELAY ? MAX_DELAY : delay * 2))
    done
    WAITED=$(($(now) - start))
}

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/ssa.XXXXXX") || exit 255
ssh_pid=
tee_pid=
cleanup() { rm -r "$tmpdir"; }
stop() {
    local status=$1
    trap - INT TERM
    [[ -n $ssh_pid ]] && kill -TERM "$ssh_pid" 2>/dev/null
    [[ -n $tee_pid ]] && kill -TERM "$tee_pid" 2>/dev/null
    [[ -n $ssh_pid ]] && wait "$ssh_pid" 2>/dev/null
    [[ -n $tee_pid ]] && wait "$tee_pid" 2>/dev/null
    exit "$status"
}
trap cleanup EXIT
trap 'stop 130' INT
trap 'stop 143' TERM
errfile=$tmpdir/err
fifo=$tmpdir/fifo
mkfifo "$fifo" || exit 255
rc=0

# ssh's stderr must both pass through live (a remote command writes to it) and be
# read back to classify the failure. A fifo does both, and waiting on the tee
# guarantees the file is complete before it is read. ssh is asynchronous only so
# a signal trap can stop it; `<&0` is load-bearing, because bash gives an
# asynchronous command /dev/null for stdin unless a redirection says otherwise.
run_ssh() {
    tee "$errfile" <"$fifo" >&2 &
    tee_pid=$!
    ssh -o BatchMode=yes ${ssh_opts[@]+"${ssh_opts[@]}"} ${tmux_session:+-t} "$host" \
        ${eff_cmd[@]+"${eff_cmd[@]}"} <&0 2>"$fifo" &
    ssh_pid=$!
    wait "$ssh_pid"
    rc=$?
    ssh_pid=
    # ssh has exited, so everything we need is already in the pipe. But a
    # ProxyCommand descendant inherits fd 2, and while it lives the write end
    # stays open and tee never sees EOF -- waiting on tee unconditionally hands a
    # grandchild the power to delay the diagnosis, and the deadline with it, for
    # as long as it likes. So the drain is bounded and then tee is stopped.
    local i
    for ((i = 0; i < DRAIN * 20; i++)); do
        kill -0 "$tee_pid" 2>/dev/null || break
        sleep 0.05
    done
    kill -TERM "$tee_pid" 2>/dev/null
    wait "$tee_pid" 2>/dev/null
    tee_pid=
}

while :; do
    run_ssh
    # Any non-255 status is definitely the remote command's. Exit 255 needs the
    # fatal and replay-safety policies below because a remote command may use it.
    ((rc != 255)) && exit "$rc"

    diagnose "$(<"$errfile")"

    if [[ $CLASS == fatal ]]; then
        [[ $REASON == 'host key changed' ]] &&
            say "a rebuilt host and a MITM look the same here; verify, then fix known_hosts"
        die "not reconnecting: $REASON"
    fi

    # Remote stderr shares errfile with ssh diagnostics, and a remote command may
    # itself return 255. No wording can prove it never started, so it is never
    # replayed; tmux is exempt because it is our own idempotent command.
    ((${#user_cmd[@]})) &&
        die "ssh exited 255 and '${user_cmd[*]}' may have run; run it under --tmux to survive a drop"

    # `~.` and a dead link are the same silent 255, so offer a way out. The key
    # is named: a dying full-screen program leaves escape bytes in the input
    # queue, and those are not someone asking to stop.
    if [[ $CLASS == dropped && -t 0 ]]; then
        printf '%s: reconnecting in %ss, q to stop' "$PROG" "$GRACE" >&2
        read -rs -n 1 -t "$GRACE" key && [[ $key == q ]] && { printf '\n' >&2; exit 255; }
        printf '\n' >&2
    fi

    # No reason here: the line before it is the reason, and repeating it is what
    # pushes this shape past 80 columns.
    wait_for || die "gave up on $short_host after $(dur "$WAITED")"
    ((WAITED > 30)) && printf '\a' >&2   # long enough that nobody was watching
    say "$short_host back after $(dur "$WAITED"), reconnecting"
done
