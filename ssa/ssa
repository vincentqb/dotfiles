#!/usr/bin/env bash
# ssa -- ssh that waits out a broken network and reconnects. Never prompts: it
# reports what it is waiting for and picks it up on the next probe.
# Why bash, and how each failure mode is detected: README.md.

set -uo pipefail

PROG=${0##*/}
# ssh short options that take an argument (OpenSSH 7.4 synopsis).
ARGOPTS='bcDEeFIiJLlmOopQRSWw'
# bash 4.2: "${a[@]}" on an empty array dies under set -u, hence ${a[@]+...}.

max_wait=${SSA_MAX_WAIT:-0}
grace=${SSA_GRACE:-3}
probe_timeout=${SSA_PROBE_TIMEOUT:-7}
cert=${SSA_CERT:-$HOME/.ssh/id_rsa-cert.pub}
tmux_session=
retry_command=0

usage() {
    cat <<'EOF'
usage: ssa [--tmux[=NAME]] [--retry-command] [--max-wait=SECS] [ssh args] host [cmd]

  --tmux[=NAME]    attach-or-create remote tmux NAME (default main), so the
                   session survives a reconnect too; implies -t
  --retry-command  re-run the remote command after a mid-session drop
  --max-wait=SECS  give up on one reconnect after SECS (0 = never)

Credentials, VPN and portals are waited on, never solved for you.
EOF
}

say() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { say "$*"; exit 255; }
now() { date +%s; }
dur() { if (($1 < 60)); then printf '%ds' "$1"; else printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); fi; }

# One left-to-right pass: our long options and a remote command can be spelled
# the same, so only tokens before the hostname are ours.
ssh_opts=()
user_cmd=()
host=
argv=("$@")
i=0
while ((i < ${#argv[@]})); do
    a=${argv[i]}
    case $a in
        --help) usage; exit 0 ;;
        --tmux) tmux_session=main ;;
        --tmux=*) tmux_session=${a#*=} ;;
        --retry-command) retry_command=1 ;;
        --max-wait=*) max_wait=${a#*=} ;;
        --*) die "unknown option $a" ;;
        -?*)
            ssh_opts+=("$a")
            # Consume the next token only if an argument-taking flag ends the
            # cluster: -p22, -p 22 and -tp 22 are all legal.
            r=${a#-}
            while [[ -n $r && $ARGOPTS != *"${r:0:1}"* ]]; do
                # -f backgrounds ssh, which returns 0 at once and leaves nothing
                # to supervise. Only the no-argument prefix of a cluster is
                # examined, so -F and an -i path are not mistaken for it.
                [[ ${r:0:1} == f ]] &&
                    die "-f backgrounds ssh, leaving nothing to supervise; drop it and background $PROG instead"
                r=${r:1}
            done
            if [[ -n $r && -z ${r:1} ]]; then
                ((++i < ${#argv[@]})) || die "option $a needs an argument"
                ssh_opts+=("${argv[i]}")
            fi
            ;;
        # Quoted: the remote command is ssh's to interpret, not ours to glob.
        *) host=$a; user_cmd=("${argv[@]:i+1}"); break ;;
    esac
    ((i++))
done
[[ -n $host ]] || { usage; exit 2; }

# autossh's -M monitor exists because nothing reconnects if nothing notices the
# link died. ssh's ServerAliveInterval is that check, and its default is 0: on a
# dead link ssh blocks until the kernel gives up, so there is nothing to
# supervise and this whole script does nothing. Refuse rather than inject one --
# it belongs in ssh_config, where plain ssh benefits too, and a wrapper quietly
# rewriting connection parameters is worse than being told once.
[[ $(ssh -G ${ssh_opts[@]+"${ssh_opts[@]}"} "$host" 2>/dev/null |
    awk '$1 == "serveraliveinterval" { print $2; exit }') == 0 ]] &&
    die "$host has no ServerAliveInterval, so ssh will never notice a dead link.
    Add to ~/.ssh/config:
        Host *
            ServerAliveInterval 30
            ServerAliveCountMax 3"

eff_cmd=(${user_cmd[@]+"${user_cmd[@]}"})
if [[ -n $tmux_session ]]; then
    ((${#user_cmd[@]} == 0)) || die "--tmux replaces the remote command"
    eff_cmd=(tmux new -A -s "$tmux_session")   # -A attaches or creates
fi

# fatal: retrying cannot help. auth: credentials refused. connect: no session
# existed, so retrying is always safe. dropped (the default): one died, so a
# remote command may have half-run.
classify() {
    case $1 in
        *"IDENTIFICATION HAS CHANGED"* | *"Host key verification failed"* | \
        *"Bad configuration option"* | *"illegal option"* | *"unknown option"*) echo fatal ;;
        *"Permission denied"* | *"Too many authentication failures"*) echo auth ;;
        *"Could not resolve"* | *"Name or service not known"* | *"Connection refused"* | \
        *"Connection timed out"* | *"Operation timed out"* | *"No route to host"* | \
        *"Network is unreachable"* | *exchange_identification*) echo connect ;;
        *) echo dropped ;;
    esac
}

# Only meaningful once ssh has said Permission denied -- and the host may not use
# this certificate at all, which is what the second branch reports.
cert_note() {
    local to exp
    to=$(ssh-keygen -L -f "$cert" 2>/dev/null | sed -n 's/.*Valid: from .* to \([^ ]*\).*/\1/p')
    exp=$(date -d "$to" +%s 2>/dev/null || date -j -f '%Y-%m-%dT%H:%M:%S' "$to" +%s 2>/dev/null) ||
        return 0
    if (($(now) > exp)); then printf 'certificate expired %s ago' "$(dur $(($(now) - exp)))"
    else printf 'certificate is live, so this is not the cert'; fi
}

# ssh explains itself on stderr, so its last real line is the reason. Only
# credentials need more, because "Permission denied" does not say why.
reason_for() {
    if [[ $(classify "$1") == auth ]]; then
        local note
        note=$(cert_note)
        printf 'credentials rejected%s' "${note:+ ($note)}"
    else
        grep -v '^Warning: Permanently added' <<<"$1" | grep . | tail -1 | sed 's/^ssh: //'
    fi
}

# The one failure waiting never fixes, so it is worth its own probe.
portal() {
    local code
    code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 \
        http://connectivitycheck.gstatic.com/generate_204 2>/dev/null)
    [[ -n $code && $code != 204 && $code != 000 ]] &&
        printf 'captive portal? probe got HTTP %s -- sign in from a browser' "$code"
}

# A real ssh, so aliases, ports and ProxyJump hold, but quiet and short-fused.
# Our -o win because ssh keeps the first value it obtains for an option.
probe_err=
probe() {
    probe_err=$(ssh -o BatchMode=yes -o ConnectTimeout="$probe_timeout" -o ControlMaster=no \
        ${ssh_opts[@]+"${ssh_opts[@]}"} "$host" true 2>&1 >/dev/null)
}

# A master that died with the link leaves a socket that fails the next connect
# instantly. No-op when multiplexing is off.
stale_master() {
    ssh ${ssh_opts[@]+"${ssh_opts[@]}"} -O check "$host" >/dev/null 2>&1 ||
        ssh ${ssh_opts[@]+"${ssh_opts[@]}"} -O exit "$host" >/dev/null 2>&1 || true
}

WAITED=0
wait_for() {
    local delay=1 start reason spotted
    start=$(now)
    say "$1; waiting"
    while ! probe; do
        WAITED=$(($(now) - start))
        ((max_wait > 0 && WAITED >= max_wait)) && return 1
        reason=$(reason_for "$probe_err")
        spotted=$(portal) && reason=$spotted
        say "${reason:-unreachable} -- retry in $(dur "$delay") (waited $(dur "$WAITED"))"
        sleep "$delay"
        ((delay = delay * 2 > 30 ? 30 : delay * 2))
    done
    WAITED=$(($(now) - start))
}

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/ssa.XXXXXX") || exit 255
trap 'rm -rf "$tmpdir"' EXIT
trap 'exit 130' INT TERM
errfile=$tmpdir/err
fifo=$tmpdir/fifo
mkfifo "$fifo" || exit 255
rc=0

# ssh's stderr must both pass through live (a remote command writes to it) and be
# read back to classify the failure. A fifo does both, and waiting on the tee
# guarantees the file is complete before it is read.
run_ssh() {
    local pid
    tee "$errfile" <"$fifo" >&2 &
    pid=$!
    ssh ${ssh_opts[@]+"${ssh_opts[@]}"} ${tmux_session:+-t} "$host" \
        ${eff_cmd[@]+"${eff_cmd[@]}"} 2>"$fifo"
    rc=$?
    wait "$pid" 2>/dev/null
}

while :; do
    run_ssh
    # Only ssh's own 255 is ours; any other status is the remote command's.
    ((rc != 255)) && exit "$rc"

    err=$(<"$errfile")
    class=$(classify "$err")
    reason=$(reason_for "$err")

    if [[ $class == fatal ]]; then
        [[ $err == *"IDENTIFICATION HAS CHANGED"* ]] &&
            say "the host key changed; a rebuilt host and a MITM look alike from here, so fix known_hosts yourself"
        die "not retrying: ${reason:-ssh exited 255}"
    fi

    ((${#user_cmd[@]})) && [[ $class == dropped ]] && ((retry_command == 0)) &&
        die "dropped, and '${user_cmd[*]}' may have already run (--retry-command to allow)"

    # `~.` and a dead link are the same silent 255, so offer a way out.
    if [[ $class == dropped && -t 0 ]]; then
        printf '%s: %s -- reconnecting in %ss, press a key to stop... ' \
            "$PROG" "${reason:-session ended}" "$grace" >&2
        read -rs -n 1 -t "$grace" && { echo >&2; exit 255; }
        echo >&2
    fi

    stale_master
    wait_for "${reason:-unreachable}" || die "gave up on $host after $(dur "$WAITED")"
    ((WAITED > 30)) && printf '\a' >&2   # you probably walked away
    say "$host is back after $(dur "$WAITED"); reconnecting"
done
