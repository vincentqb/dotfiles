**/config/nvim/undodir/

**/tmux/plugins
**/vim/.netrwhist
**/ipython/profile_default/history.sqlite
**/ipython/profile_default/history-corrupt-*.sqlite
**/config/fish/functions/_*.fish
**/config/fish/fish_variables

**/ssh/id_*
**/ssh/id_*.pub
**/ssh/*.pem
**/ssh/known_hosts*

**/*.rendered
**/.DS_Store

**/__pycache__/
**/.ruff_cache/

# Credentials. This repo is public, so these are listed first and by exact name:
# a wildcard that stops matching after a tool renames its store fails silently,
# and unlike the rest of this file that failure is not recoverable by editing it.
**/claude/.credentials.json
**/kiro/secrets.json
**/config/gh/hosts.yml
**/config/grasp-mcp/*.cookies

# Agent state: caches, queues, logs, transcripts and watch dirs that tools write
# while running. Tracking any of them makes `git status` useless and every commit
# a diff of someone else's bookkeeping -- kiro/sessions alone is 36k files.
**/claude/.amzn/
**/claude/.claude/
**/claude/.last-cleanup
**/claude/.setup-state
**/claude/cache/
**/claude/daemon/
**/claude/daemon.log
**/claude/debug/
**/claude/jobs/
**/claude/mcp-needs-auth-cache.json
**/claude/model-watch/
**/claude/pane-watch/
**/claude/paste-cache/
**/claude/science-commits/
**/claude/urgent/
**/codex/
**/kiro/.cli_bash_history
**/kiro/agents/
**/kiro/logs/
**/kiro/session-index/
**/kiro/sessions/
**/kiro/settings/*.lock
**/kiro/settings/feed_state.json
**/kiro/settings/survey_state.json

# Per-tool state under ~/.config. Only the entries this repo deliberately carries
# are tracked, so state directories are named rather than covered by a wildcard --
# a new tool should be a decision, not an accident.
**/config/ada/
**/config/brazil/
**/config/configstore/
**/config/google-chrome-for-testing/
**/config/grasp-mcp/
**/config/herdr/
**/config/leancloud/
**/config/rde/
**/config/smithy-mcp/

# Installed by fisher, not by us.
**/config/fish/functions/fisher.fish
