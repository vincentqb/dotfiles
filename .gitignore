**/config/nvim/undodir/

**/tmux/plugins
**/vim/.netrwhist
**/ipython/profile_default/history.sqlite
**/ipython/profile_default/history-corrupt-*.sqlite
**/config/fish/functions/_*.fish
**/config/fish/fish_variables

**/ssh/id_*
**/ssh/id_*.pub
**/ssh/*.pem
**/ssh/known_hosts*

**/*.rendered
**/.DS_Store

**/__pycache__/
**/.ruff_cache/

# Credentials. This repo is public, so these are listed first and by exact name:
# a wildcard that stops matching after a tool renames its store fails silently,
# and unlike the rest of this file that failure is not recoverable by editing it.
**/claude/.credentials.json
**/kiro/secrets.json
**/config/gh/hosts.yml
**/config/grasp-mcp/*.cookies

# claude, codex and kiro hold live tool state, so each carries its own allowlist
# .gitignore that tracks only authored files.

# Per-tool state under ~/.config. Only the entries this repo deliberately carries
# are tracked, so state directories are named rather than covered by a wildcard --
# a new tool should be a decision, not an accident.
**/config/ada/
**/config/brazil/
**/config/configstore/
**/config/google-chrome-for-testing/
**/config/grasp-mcp/
**/config/herdr/
**/config/leancloud/
**/config/rde/
**/config/smithy-mcp/

# Generated, not authored: fisher installs conf.d and completions from
# fish_plugins, rustup and Fig drop their own, and fish_config writes the frozen
# theme and key bindings. Keep authored startup and completion overrides, but
# ignore generated output, like tmux/plugins and functions/_*.fish above.
**/config/fish/functions/fisher.fish
**/config/fish/completions/*
!default/config/fish/completions/git.fish
**/config/fish/conf.d/*
!default/config/fish/conf.d/00-dotfiles.fish

**/config/vera/secrets/
