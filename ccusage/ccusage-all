# USD per Kiro credit (default) and the asymmetric band multipliers printed
# beside the Kiro subtotal. Derived, not guessed: calibrate.py re-derives both
# from local Kiro data, and FINDINGS.md carries the argument.
USD_PER_CREDIT = 0.0747
KIRO_BAND = (0.0647 / 0.0747, 0.1405 / 0.0747)

# The mix assumption hiding inside USD_PER_CREDIT, made explicit. The derivation
# is $/credit = (fresh-input $/credit) x (mix factor), where the mix factor is a
# token-share-weighted average of the price ratios below. Kiro's default asserts
# 100% cache-read, hence 0.100 -- the ONLY harness here that assumes a mix rather
# than measuring one, because it logs no token buckets at all.
#
# Price ratios relative to fresh input, identical across the Claude family and
# the GPT family (deepseek is the lone exception at cache-read 0.2):
KIRO_PRICE_RATIO = {"in": 1.00, "cr": 0.10, "cw": 1.25}
KIRO_DEFAULT_MIX = {"cr": 1.00, "cw": 0.00, "in": 0.00}    # 100% cache-read


def kiro_mix_factor(mix):
    """Token-share-weighted price ratio: the multiplier on the fresh-input
    $/credit that yields the rate for an assumed mix."""
    return sum(mix[bucket] * KIRO_PRICE_RATIO[bucket] for bucket in KIRO_PRICE_RATIO)


KIRO_ASSUMED_MIX = 0.100                                  # its factor
KIRO_FRESH_INPUT_RATE = USD_PER_CREDIT / KIRO_ASSUMED_MIX  # $0.7468/credit

# The default $/credit is DERIVED from KIRO_DEFAULT_MIX through the same
# expression --kiro-mix uses, so the mix the table shows is the mix the cost was
# computed with. It was not always: the default path used to pass USD_PER_CREDIT
# straight through while the mix was displayed from a separate constant, so
# editing one without the other would have rendered `~80%/~20%` on rows still
# priced at 100% cache-read. This assert is what keeps the displayed assumption
# load-bearing rather than decorative.
assert abs(kiro_mix_factor(KIRO_DEFAULT_MIX) - KIRO_ASSUMED_MIX) < 1e-12, (
    f"KIRO_DEFAULT_MIX factor {kiro_mix_factor(KIRO_DEFAULT_MIX)} != "
    f"KIRO_ASSUMED_MIX {KIRO_ASSUMED_MIX}; the table would show a mix that did "
    f"not produce the rate")
KIRO_DEFAULT_RATE = KIRO_FRESH_INPUT_RATE * kiro_mix_factor(KIRO_DEFAULT_MIX)
#
# `--kiro-mix CR/CW` substitutes a different assumed mix. The measured mixes of
# the token-logged harnesses, for calibration, are:
#
#   claude    95.1% cache-read / 4.4% cache-write  -> input-side factor 0.151
#   opencode  86.5% / 0.0%                         -> 0.209
#   codex     75.9% / 0.0%                         -> 0.313
#   l3m       75.4% / 5.2%                         -> 0.329
#
# `--kiro-mix 95/5` borrows Claude Code's, which is the defensible proxy: Kiro is
# an Anthropic-model agentic CLI with automatic cache management, architecturally
# its twin, and FINDINGS.md's own premise is that Kiro traffic is overwhelmingly
# cached input. It yields $0.1176/credit, +57%, and lands 70% of the way up the
# existing band -- corroboration, since the band's lopsided +88% was absorbing
# exactly this. Beware: cache-WRITE dominates the correction. At 95/5 the 5%
# contributes 0.0625 against cache-read's 0.095, so 40% of the factor comes from
# the small share, and 90/10 breaks out of the band entirely.
#
# Output is deliberately excluded: k was calibrated on CONTEXT tokens, which are
# input-side, so correcting the input-side mix does not double-count -- whereas
# FINDINGS.md argues the 1.80x bimodality in k already IS unreported output, so
# adding an output term would count it twice.


def kiro_mix_rate(spec):
    """`--kiro-mix CR/CW` -> {"cr", "cw", "in", "rate"} at that assumed mix.

    CR and CW are percentages of input-side tokens; any remainder is fresh
    input. `--kiro-mix 95/5` is Claude Code's measured mix. The shares travel
    with the rate so the table can SHOW the assumption rather than leave Kiro's
    mix columns blank -- an assumed 100% is a claim, and a blank hides it."""
    try:
        parts = [float(p) for p in spec.split("/")]
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"expected CR/CW percentages, got {spec!r}") from None
    if len(parts) != 2 or not all(p >= 0 for p in parts) or sum(parts) > 100:
        raise argparse.ArgumentTypeError(
            f"expected two non-negative percentages summing to <=100, got {spec!r}")
    cr, cw = (p / 100 for p in parts)
    # Round the remainder: 1 - 0.95 - 0.05 is 4.2e-17 in binary floating point,
    # which would render as a spurious fresh-input share in --json.
    mix = {"cr": cr, "cw": cw, "in": max(0.0, round(1 - cr - cw, 10))}
    return {**mix, "rate": KIRO_FRESH_INPUT_RATE * kiro_mix_factor(mix)}

