# $/credit if every token were billed at FRESH INPUT prices: calibrate.py step
# 3's `base`, = 1/(anchor x 1e6 x k). Every rate below is this times a mix factor,
# so the assumed mix is always a visible multiplicand. FINDINGS.md has the
# derivation.
KIRO_FRESH_INPUT_RATE = 0.7468

# Price ratios relative to fresh input, identical across the Claude family and
# the GPT family (deepseek is the lone exception at cache-read 0.2):
KIRO_PRICE_RATIO = {"in": 1.00, "cr": 0.10, "cw": 1.25}

# Kiro publishes no token buckets, so its mix is ASSUMED. Round on purpose: it is
# a guess and should read as one.
#
# Cache-read share is a HARNESS property, not a model one: the same claude-opus-5
# measures 95.3% under Claude Code and 87.1% under l3m, while four models under
# Claude Code all land within 1.8 points (94.4 / 95.1 / 95.3 / 96.2). Measurable
# harnesses span 75.4%-95.1% and Claude Code is the ceiling, so 90% sits inside
# that range rather than assuming Kiro caches best of all.
#
# The 5% cache-write is the best-grounded term (Anthropic models measure 4.2-4.6%,
# and 83% of Kiro credits are Claude). The 5% fresh-input remainder is not a
# rounding artifact: fresh input is 10x a cache read, so it is a quarter of the
# factor. Output is excluded -- k was calibrated on context tokens, and
# FINDINGS.md argues k's 1.80x bimodality already IS unreported output.
KIRO_DEFAULT_MIX = {"cr": 0.90, "cw": 0.05, "in": 0.05}


def kiro_mix_factor(mix):
    """Token-share-weighted price ratio: the multiplier on the fresh-input
    $/credit that yields the rate for an assumed mix."""
    return sum(mix[bucket] * KIRO_PRICE_RATIO[bucket] for bucket in KIRO_PRICE_RATIO)


# Derived from the mix above, never hardcoded, so the two cannot disagree.
KIRO_DEFAULT_RATE = KIRO_FRESH_INPUT_RATE * kiro_mix_factor(KIRO_DEFAULT_MIX)

# Band multipliers from calibrate.py step 5, stored as RATIOS: both error sources
# (the credits-per-token spread and the multiplier-to-price anchor) scale the rate
# multiplicatively, so the band recentres on whatever mix is in force.
KIRO_BAND = (0.0647 / 0.0747, 0.1405 / 0.0747)

# Measured input-side mixes, for comparison against the assumption above.
# Cache-write is unobservable for codex, not zero, so its factor is a floor.
#
#   claude    95.6% cache-read / 4.4% cache-write  -> factor 0.151
#   opencode  86.5% / 0.0%                         -> 0.209
#   codex     76.4% / unobservable                 -> 0.313
#   l3m       79.5% / 5.5%                         -> 0.329


L3M_ALIASES = {
    "opus": "claude-opus-4-8",
    "sonnet": "claude-sonnet-4-6",
    "haiku": "claude-haiku-4-5",
    "fable": "claude-fable-5",
    "gpt": "gpt-5.6-sol",
}


def canon(model):
    """Strip provider/region prefixes (`us.anthropic.`, `openai.`) so names from
    different logs line up. Dated snapshots resolve to their family by the
    longest-prefix lookup in litellm_rates."""
    key = (model or "").lower()
    for prefix in ("us.", "eu.", "apac.", "global.", "anthropic.", "openai."):
        while key.startswith(prefix):
            key = key[len(prefix):]
    return key


def kiro_turns(session_dir):
    """Yield (timestamp, execution_id, credits, model) per completed Kiro turn.

    Credits arrive on a `usage_summary` record, but the model that spent them is
    only named on the `assistant` records sharing its `executionId` -- so collect
    both in one pass and join at the end."""
    messages = session_dir / "messages.jsonl"
    if not messages.is_file():
        return
    models, summaries = {}, []
    with messages.open() as handle:
        for line in handle:
            if "usage_summary" not in line and "reasoningModelId" not in line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = record.get("payload") or {}
            execution_id = payload.get("executionId") or record.get("id")

            if payload.get("type") == "assistant" and payload.get("reasoningModelId"):
                # Namespaced "qdev::claude-opus-5"; keep the bare model name.
                models.setdefault(execution_id,
                                  payload["reasoningModelId"].rpartition("::")[2])
                continue

            if payload.get("type") != "usage_summary":
                continue
            credits = sum(
                summary.get("usage", 0)
                for summary in payload.get("promptTurnSummaries") or []
                if str(summary.get("unit", "")).lower().startswith("credit")
            )
            if credits > 0:
                summaries.append((record.get("timestamp"), execution_id, credits))

    for timestamp, execution_id, credits in summaries:
        yield timestamp, execution_id, credits, models.get(execution_id)


def kiro_rows(credit_rate, assumed_mix=None):
    """Per (day, model) Kiro credits from its session logs. Turns key on
    `executionId`, stable across re-reads, so a turn recorded twice counts once.

    Credits are reported exactly as found, and the scan is known incomplete:
    measured 2026-08-27 it read 5.1% below `/usage`, Kiro's own authoritative
    total (63,061.16 against 66,425.17). Deliberately not scaled up by that ratio
    -- it was one aggregate measurement over one period, and multiplying every day
    and model by it spreads the miss proportionally when its known component
    (v1/v2-engine turns, ~0.4%) is not spread that way. Read the total as a floor,
    roughly 5% low.

    `assumed_mix` is the mix `credit_rate` came from, carried per row so
    validate_rows can check the two agree."""
    days = collections.defaultdict(lambda: collections.defaultdict(float))
    seen = set()
    for session_dir in sorted(KIRO_SESSIONS.glob("*/sess_*")):
        try:
            meta = json.loads((session_dir / "session.json").read_text())
        except (OSError, json.JSONDecodeError):
            meta = {}
        # session.json names one model for the whole session, which is wrong for
        # a session that switched models; the per-turn join wins where it
        # succeeded, and this is only the fallback.
        session_model = meta.get("modelId") or "kiro-unknown"
        for timestamp, execution_id, credits, model in kiro_turns(session_dir):
            day = (timestamp or "")[:10]
            if not day or not execution_id or execution_id in seen:
                continue
            seen.add(execution_id)
            days[day][model or session_model] += credits
    rows = []
    for day, models in days.items():
        for model, credits in models.items():
            rows.append({
                "day": day, "harness": "kiro", "model": model,
                "consumed": credits, "unit": "credits", "rate": credit_rate,
                "cost": credits * credit_rate, "tokens": None,
                "assumed_mix": assumed_mix, "unmeasured": (),
                "provenance": provenance(
                    consumed=METERED, cost="kiro-credit",
                    # The only harness that assumes its mix instead of
                    # counting it, because it publishes no token buckets.
                    mix=ASSUMED),
            })
    return rows


def l3m_settings():
    """`~/.l3m/settings.json`, or `{}` if it is absent or unreadable."""
    try:
        return json.loads((L3M_HOME / "settings.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def l3m_hub_path(settings):
    """Where l3m's hub lives: `$L3M_HUB`, else settings `hub.path`, else the
    default `~/.l3m/hub.git` (L3m/Runtime/HubBoot.lean)."""
    configured = os.environ.get("L3M_HUB") or (settings.get("hub") or {}).get("path")
    return pathlib.Path(configured).expanduser() if configured else L3M_HOME / "hub.git"


def l3m_model(state, default_model):
    """The session's brain: the `--model=` it was started with, else the
    configured default (settings `llm.model`; `None` when that is unset too, and
    l3m's own built-in default -- unknowable from out here -- applies).

    Attribution is per SESSION, not per call: the sidecar's counters are keyed by
    wire (Anthropic / Bedrock Converse / Mantle), not by model, so a
    `consult_model` side call to another model folds into its parent's row. Only
    the model label is approximate -- `cents` is not, since l3m charged each call
    at the model it actually used."""
    name = None
    for flag in state.get("flags") or []:
        if flag.startswith("--model="):
            name = flag[len("--model="):]
    name = name or default_model
    if not name:
        return "l3m-unknown"
    name = name.removeprefix("a/")
    return canon(L3M_ALIASES.get(name, name))


def l3m_tokens(state):
    """l3m's per-wire counters mapped onto ccusage's four token buckets.

    `a_*` Anthropic native, `c_*` Bedrock Converse, `o_*` Mantle. Mantle's `o_rt`
    is the reasoning subset, billed at the output rate, so it lands in output."""
    def total(*keys):
        return sum(state.get(key, 0) for key in keys)
    return {
        "inputTokens": total("a_in", "c_in", "o_in"),
        "outputTokens": total("a_out", "c_out", "o_out", "o_rt"),
        "cacheReadTokens": total("a_cr", "c_cr"),
        "cacheCreationTokens": total("a_cw", "c_cw"),
    }


def l3m_git(hub, *args):
    """Run git in the hub. `None` if git or the hub isn't there (non-fatal:
    l3m simply contributes no rows)."""
    try:
        return subprocess.run(["git", "--git-dir", str(hub), *args],
                              check=True, capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None


def l3m_blobs(hub, shas):
    """Read many blobs in one `git cat-file --batch`.

    The sidecar blob repeats across commits (most turn boundaries republish an
    unchanged file), so the distinct blobs are far fewer than the commits and a
    `git show` per commit would be hundreds of processes. Missing objects are
    absent from the result rather than fatal."""
    shas = sorted(shas)
    if not shas:
        return {}
    try:
        out = subprocess.run(["git", "--git-dir", str(hub), "cat-file", "--batch"],
                             input=("\n".join(shas) + "\n").encode(),
                             check=True, capture_output=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return {}
    blobs, pos = {}, 0
    while pos < len(out):
        end = out.find(b"\n", pos)
        if end < 0:
            break
        header = out[pos:end].split()
        pos = end + 1
        # `<sha> <type> <size>` then that many bytes and a newline; an unknown
        # object answers `<name> missing` with no body at all.
        if len(header) < 3:
            continue
        size = int(header[2])
        blobs[header[0].decode()] = out[pos:pos + size].decode("utf-8", "replace")
        pos += size + 1
    return blobs


def l3m_samples(hub, ref):
    """[(day, sidecar)] for one state ref, oldest first.

    `--raw` names the sidecar's new blob on each commit that changed it (the
    republish-unchanged commits carry no sample), and the day is the commit's own
    local date, matching how the other harnesses are bucketed. `--no-abbrev`
    because `cat-file --batch` echoes full object names, and the two have to be
    the same key."""
    log = l3m_git(hub, "log", "--reverse", "--format=%cd", "--date=short-local",
                  "--raw", "--no-abbrev", ref, "--", L3M_SIDECAR)
    if not log:
        return []
    day, pairs = None, []
    for line in log.splitlines():
        if line.startswith(":"):
            # :<oldmode> <newmode> <oldsha> <newsha> <status>\t<path>
            fields = line.split()
            if len(fields) > 3:
                pairs.append((day, fields[3]))
        elif line.strip():
            day = line.strip()
    blobs = l3m_blobs(hub, {sha for _, sha in pairs})
    samples = []
    for day, sha in pairs:
        try:
            samples.append((day, json.loads(blobs[sha])))
        except (KeyError, json.JSONDecodeError):
            continue
    return samples


def l3m_rows(settings):
    """Per (day, model) l3m usage, differenced out of the hub's state refs.

    Each ref is one agent's sidecar series: cumulative within a conversation,
    back to zero when a new one starts in the same worktree. So a sample's delta
    against its predecessor is the usage since that predecessor -- except across
    a reset, where the whole new value is the delta.

    A reset is read off the counters GOING BACKWARDS, and only that. The sidecar
    also carries a conversation id, but it is not the reset signal it looks like:
    a resume re-mints the id while `loadLastCost` carries the counters forward,
    so treating an id change as a reset re-counts the whole session (11 such
    samples in this hub, and the same pattern on a long session would double a
    three-figure total). Cost of ignoring it: a fresh conversation whose first
    published turn already exceeds the previous conversation's lifetime total
    reads as a continuation, undercounting by that previous total -- which, in
    that situation, is by construction the smaller of the two numbers."""
    hub = l3m_hub_path(settings)
    default_model = (settings.get("llm") or {}).get("model")
    days = collections.defaultdict(lambda: collections.defaultdict(
        lambda: {"cents": 0, "tokens": collections.Counter()}))
    for ref in (l3m_git(hub, "for-each-ref", "--format=%(refname)", L3M_STATE_REFS) or "").split():
        prev = None
        for day, state in l3m_samples(hub, ref):
            cents, tokens = state.get("cents", 0), l3m_tokens(state)
            total = sum(tokens.values())
            if prev is None:
                # Oldest sample in this ref: a conversation already under way,
                # whose spend is real but undated (see the module docstring).
                delta_cents, delta_tokens, when = cents, tokens, None
            elif cents < prev["cents"] or total < prev["total"]:
                delta_cents, delta_tokens, when = cents, tokens, day
            else:
                delta_cents = cents - prev["cents"]
                delta_tokens = {k: v - prev["tokens"][k] for k, v in tokens.items()}
                when = day
            prev = {"cents": cents, "tokens": tokens, "total": total}
            if not delta_cents and not sum(delta_tokens.values()):
                continue
            # A session's brain is fixed for its life, so the flags name the
            # model even for the part that predates the record -- but when they
            # DON'T, an undated sample is old enough that today's configured
            # default says nothing about it. Guess the default only for spend we
            # can date.
            bucket = days[when][l3m_model(state, default_model if when else None)]
            bucket["cents"] += delta_cents
            bucket["tokens"].update(delta_tokens)

    rows = []
    for day, models in days.items():
        for model, bucket in models.items():
            cost = bucket["cents"] / 100.0
            mtok = sum(bucket["tokens"].values()) / 1e6
            rows.append({
                "day": day, "harness": "l3m", "model": model,
                "consumed": mtok, "unit": "Mtok",
                "rate": (cost / mtok) if mtok else 0.0,
                "cost": cost, "tokens": dict(bucket["tokens"]),
                "assumed_mix": None, "unmeasured": (),
                "provenance": provenance(
                    consumed=COUNTED,
                    # l3m self-prices: `cents` is its own bookkeeping, charged at
                    # the model each call actually used, so --rates never moves
                    # these rows.
                    cost="l3m-self", mix=MEASURED),
            })
    return rows


def local_day(ts_iso):
    """RFC3339 timestamp -> this box's local date, matching ccusage's bucketing."""
    return (datetime.datetime.fromisoformat(ts_iso.replace("Z", "+00:00"))
            .astimezone().date().isoformat())


def ts_millis(ts_iso):
    """RFC3339 timestamp -> epoch ms, or None when unparseable."""
    try:
        return int(datetime.datetime.fromisoformat(
            ts_iso.replace("Z", "+00:00")).timestamp() * 1000)
    except (ValueError, AttributeError, TypeError):
        return None


def cache_read(name):
    """Parsed CACHE_DIR/<name>.json, or None; version mismatches read as None."""
    try:
        data = json.loads((CACHE_DIR / f"{name}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return data if data.get("v") == CACHE_VERSION else None


def cache_write(name, obj):
    """Atomic write; failure is non-fatal (the data is already in hand)."""
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_DIR / f"{name}.tmp"
        tmp.write_text(json.dumps({"v": CACHE_VERSION, **obj}))
        os.replace(tmp, CACHE_DIR / f"{name}.json")
    except OSError:
        pass


def stat_walk(root, suffix=".jsonl"):
    """{relpath: (size, mtime_ns, fullpath)} for matching files under root."""
    files = {}
    root = str(root)
    for dirpath, _, names in os.walk(root):
        for name in names:
            if not name.endswith(suffix):
                continue
            full = os.path.join(dirpath, name)
            try:
                st = os.stat(full)
            except OSError:
                continue
            files[os.path.relpath(full, root)] = (st.st_size, st.st_mtime_ns, full)
    return files


# --- Claude Code -------------------------------------------------------------
#
# ~/.claude/projects/<project>/**/*.jsonl, one JSON record per line; assistant
# records carry message.usage. Rules transcribed from ccusage's Rust adapter
# (adapters/claude/src/daily.rs) and validated against its output:
#   * skip isApiErrorMessage, model "<synthetic>", records without usage;
#   * dedup on (message.id, requestId) -- streaming rewrites the same message
#     id many times with partial token counts; sidechain replays re-mint the
#     requestId, so entries also match on message.id alone when either side is
#     a sidechain; the winner is non-sidechain first, then larger token total.
# Sessions resume/fork by copying history into a NEW file in the same project
# dir, and message ids never cross project dirs (verified over this box's 4.9k
# files), so a project dir is a self-contained dedup scope -- which is what
# makes per-dir caching sound.

def claude_file_entries(path):
    """Within-file-deduped [mid, req, side, day, model, in, out, cr, cw] rows."""
    keyed, anonymous = {}, []
    try:
        with open(path, "rb") as fh:
            for line in fh:
                if b'"type":"assistant"' not in line or b'"usage"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if rec.get("type") != "assistant" or rec.get("isApiErrorMessage"):
                    continue
                msg = rec.get("message") or {}
                usage = msg.get("usage") or {}
                model = msg.get("model")
                ts = rec.get("timestamp")
                if not model or model == "<synthetic>" or not ts or not usage:
                    continue
                try:
                    day = local_day(ts)
                except ValueError:
                    continue
                entry = [msg.get("id"), rec.get("requestId"),
                         1 if rec.get("isSidechain") else 0, day, model,
                         usage.get("input_tokens") or 0, usage.get("output_tokens") or 0,
                         usage.get("cache_read_input_tokens") or 0,
                         usage.get("cache_creation_input_tokens") or 0]
                if entry[0] is None:
                    anonymous.append(entry)
                    continue
                key = (entry[0], entry[1])
                if key not in keyed or claude_replaces(entry, keyed[key]):
                    keyed[key] = entry
    except OSError:
        return []
    return list(keyed.values()) + anonymous


def claude_replaces(candidate, existing):
    """ccusage's winner rule: non-sidechain beats sidechain, then more tokens."""
    if candidate[2] != existing[2]:
        return existing[2] == 1
    return sum(candidate[5:9]) > sum(existing[5:9])


def claude_dir_sums(file_entries):
    """Cross-file dedup over one project dir -> {day\\x00model: [4 tokens]}."""
    exact = {}                               # (mid, req) -> entry
    by_mid = collections.defaultdict(list)   # mid -> [(mid, req), ...]
    anonymous = []
    for rel in sorted(file_entries):
        for entry in file_entries[rel]["entries"]:
            mid, req = entry[0], entry[1]
            if mid is None:
                anonymous.append(entry)
                continue
            key = (mid, req)
            match = key if key in exact else None
            if match is None:
                # sidechain replays re-mint requestId: match mid alone
                for cand in by_mid.get(mid, ()):
                    if entry[2] or exact[cand][2]:
                        match = cand
                        break
            if match is not None:
                if claude_replaces(entry, exact[match]):
                    exact[match] = entry
                continue
            exact[key] = entry
            by_mid[mid].append(key)
    sums = collections.defaultdict(lambda: [0, 0, 0, 0])
    for entry in list(exact.values()) + anonymous:
        bucket = sums[f"{entry[3]}\x00{entry[4]}"]
        for i in range(4):
            bucket[i] += entry[5 + i]
    return dict(sums)


def claude_sums():
    """{day\\x00model: [4 tokens]} across all project dirs, incrementally cached.

    Two cache layers: per-dir day/model sums (tiny, always loaded) validated by
    a stat signature of the dir's files, and per-dir entry lists (bigger,
    loaded only when a dir changed) so an appended session file re-parses just
    itself, not its whole dir."""
    dirs = collections.defaultdict(dict)     # dirkey -> {relpath: (sz, mt, full)}
    for root in CLAUDE_PROJECTS:
        for rel, stat3 in stat_walk(root).items():
            top = rel.split(os.sep, 1)[0] if os.sep in rel else "."
            dirs[str(root / top)][rel] = stat3
    cached = (cache_read("claude-sums") or {}).get("dirs", {})
    out, totals = {}, collections.defaultdict(lambda: [0, 0, 0, 0])
    for dirkey, files in dirs.items():
        sig = hashlib.sha256(repr(sorted(
            (rel, sz, mt) for rel, (sz, mt, _) in files.items())).encode()).hexdigest()
        entry = cached.get(dirkey)
        if not entry or entry["sig"] != sig:
            entry = {"sig": sig, "sums": claude_rebuild_dir(dirkey, files)}
        out[dirkey] = entry
        for key, tok in entry["sums"].items():
            bucket = totals[key]
            for i in range(4):
                bucket[i] += tok[i]
    if out != cached:
        cache_write("claude-sums", {"dirs": out})
        keep = {claude_entries_name(dirkey) + ".json" for dirkey in out}
        for stale in CACHE_DIR.glob("claude-entries-*.json"):
            if stale.name not in keep:
                stale.unlink(missing_ok=True)
    return totals


def claude_entries_name(dirkey):
    return "claude-entries-" + hashlib.sha256(dirkey.encode()).hexdigest()[:16]


def claude_rebuild_dir(dirkey, files):
    """Re-derive one project dir's sums, re-parsing only its changed files."""
    name = claude_entries_name(dirkey)
    old = (cache_read(name) or {}).get("files", {})
    new = {}
    for rel, (size, mtime, full) in files.items():
        prev = old.get(rel)
        if prev and prev["sig"] == [size, mtime]:
            new[rel] = prev
        else:
            new[rel] = {"sig": [size, mtime], "entries": claude_file_entries(full)}
    cache_write(name, {"files": new})
    return claude_dir_sums(new)


# --- Codex -------------------------------------------------------------------
#
# ~/.codex/sessions/**/*.jsonl (rollout files; archived_sessions too), one
# `token_count` event per turn carrying cumulative and per-turn usage. Rules
# transcribed from ccusage's adapters/codex/src/{parser,aggregate,replay}.rs
# and validated token-for-token against its output:
#   * an event counts only when the cumulative totals advanced; its usage is
#     last_token_usage, else the delta of cumulative totals;
#   * a forked session file replays its parent's history with rewritten
#     timestamps -- skip the prefix of events matching the parent's stream up
#     to the fork instant; without a parent log, skip the opening burst of
#     events written <=1s apart (a real first turn follows a pause);
#   * dedup across everything on (timestamp, model, full usage tuple);
#   * reported input excludes cached tokens, which count as cache reads.

CODEX_USAGE_KEYS = ("input_tokens", "cached_input_tokens", "output_tokens",
                    "reasoning_output_tokens", "total_tokens")
CODEX_BURST_MS = 1000

# OpenAI's two-stage pricing: a turn whose logged input exceeds the threshold
# is billed entirely at the long-context rates (USD/1M, same tiers). Rates and
# the 272K boundary from models.dev / LiteLLM `*_above_272k_tokens` entries;
# `--online` does not refresh these (they change even more rarely than the
# base rates). Known deliberate divergence from ccusage: its pricing entry for
# the provider-prefixed key `openai.gpt-5.5` carries no tier data, so ccusage
# silently applies its generic 200K default to that model and overprices turns
# in the 200K-272K band (~$15 here); this table uses the published 272K
# boundary for the whole family instead.
CODEX_LONG_CONTEXT = {
    "gpt-5.6-sol": (272_000, (10.0, 45.0, 1.0, 12.5)),
    "gpt-5.5":     (272_000, (10.0, 45.0, 1.0, 0.0)),
    "gpt-5.4":     (272_000, (5.0, 22.5, 0.5, 0.0)),
}


def codex_parse_file(path):
    """(meta, events) for one rollout file, cumulative-advance filtered.

    meta: {sid, parent, forked_at}; event: [ts, ms, day, model, [5 usage]]."""
    meta, events = {}, []
    model, prev_totals = None, None
    try:
        with open(path, "rb") as fh:
            for line in fh:
                if b'"session_meta"' in line and not meta:
                    try:
                        rec = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if rec.get("type") == "session_meta":
                        payload = rec.get("payload") or {}
                        meta = {"sid": payload.get("session_id") or payload.get("id"),
                                "parent": payload.get("forked_from_id"),
                                "forked_at": ts_millis(payload.get("timestamp"))}
                    continue
                if b'"turn_context"' in line:
                    try:
                        rec = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if rec.get("type") == "turn_context":
                        model = (rec.get("payload") or {}).get("model") or model
                    continue
                if b'"token_count"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                payload = rec.get("payload") or {}
                if payload.get("type") != "token_count":
                    continue
                info = payload.get("info") or {}
                total = info.get("total_token_usage")
                advanced = total is None or total != prev_totals
                last = info.get("last_token_usage") if advanced else None
                if last is None and total is not None:
                    prev = prev_totals or {}
                    last = {k: max(0, (total.get(k) or 0) - (prev.get(k) or 0))
                            for k in CODEX_USAGE_KEYS}
                if total is not None:
                    prev_totals = total
                if not last:
                    continue
                usage = [last.get(k) or 0 for k in CODEX_USAGE_KEYS]
                if not any(usage[:4]):
                    continue
                ts = rec.get("timestamp")
                try:
                    day = local_day(ts)
                except (ValueError, AttributeError):
                    continue
                events.append([ts, ts_millis(ts), day, model or "gpt-5", usage])
    except OSError:
        pass
    return meta, events


def codex_sums():
    """({day\\x00model: [4 tokens]}, long-context portion of the same),
    incrementally cached per rollout file. The long dict holds the subset of
    the first that came from turns over the model's long-context threshold,
    for the two-stage pricing in token_rows."""
    current, seen_rel = {}, set()
    for root in (CODEX_HOME / "sessions", CODEX_HOME / "archived_sessions"):
        for rel, (size, mtime, full) in stat_walk(root).items():
            if rel in seen_rel:
                continue  # archived copy of a live session file
            seen_rel.add(rel)
            current[full] = [size, mtime]
    cached = (cache_read("codex") or {}).get("files", {})
    out = {}
    for full, sig in current.items():
        prev = cached.get(full)
        if prev and prev["sig"] == sig:
            out[full] = prev
        else:
            meta, events = codex_parse_file(full)
            out[full] = {"sig": sig, "meta": meta, "events": events}
    if out != cached:
        cache_write("codex", {"files": out})

    by_sid = {}
    for path, rec in out.items():
        sid = rec["meta"].get("sid")
        if sid:
            by_sid.setdefault(sid, path)

    deduped = {}
    for path, rec in out.items():
        meta, events = rec["meta"], rec["events"]
        parent_path = by_sid.get(meta.get("parent"))
        if meta.get("parent"):
            parent_events = (out.get(parent_path, {"events": []})["events"]
                             if parent_path and parent_path != path else [])
            forked_at = meta.get("forked_at")
            prefix = [e[4] for e in parent_events
                      if forked_at is None or e[1] is None or e[1] <= forked_at]
            state, index, prev_ms = "match", 0, None
        else:
            state, index, prev_ms = "done", 0, None

        for event in events:
            skip = False
            while True:
                if state == "match":
                    if index < len(prefix) and prefix[index] == event[4]:
                        index, skip = index + 1, True
                        break
                    if index == 0:
                        # No parent anchor: opening burst = rewritten replay.
                        stamps = [e[1] for e in events if e[1] is not None]
                        if len(stamps) >= 2 and 0 <= stamps[1] - stamps[0] <= CODEX_BURST_MS:
                            state, prev_ms = "burst", stamps[0]
                            continue
                    state = "done"
                elif state == "burst":
                    if event[1] is not None and 0 <= event[1] - prev_ms <= CODEX_BURST_MS:
                        prev_ms, skip = event[1], True
                        break
                    state = "done"
                else:
                    break
            if not skip:
                deduped[(event[0], event[3], tuple(event[4]))] = event

    sums = collections.defaultdict(lambda: [0, 0, 0, 0])
    long_sums = collections.defaultdict(lambda: [0, 0, 0, 0])
    for event in deduped.values():
        inp, cached_in, output, _reasoning, _total = event[4]
        cached_in = min(cached_in, inp)
        key = f"{event[2]}\x00{event[3]}"
        targets = [sums[key]]
        long_context = codex_long_rates(event[3])
        if long_context and inp > long_context[0]:
            targets.append(long_sums[key])
        for bucket in targets:
            bucket[0] += inp - cached_in
            bucket[1] += output
            bucket[2] += cached_in
    return sums, long_sums


def codex_long_rates(model):
    """(threshold, USD/1M rate tuple) for a model's long-context tier, or None."""
    key = canon(model)
    for name, entry in CODEX_LONG_CONTEXT.items():
        if key.startswith(name):
            return entry
    return None


# --- opencode ----------------------------------------------------------------
#
# One SQLite database; assistant messages carry a tokens object. Small enough
# (hundreds of rows) to read live every run, no cache.

def opencode_sums():
    """{day\\x00model: [4 tokens]} from opencode's message table."""
    sums = collections.defaultdict(lambda: [0, 0, 0, 0])
    if not OPENCODE_DB.is_file():
        return sums
    try:
        con = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True)
    except sqlite3.Error:
        return sums
    try:
        for (data,) in con.execute("SELECT data FROM message"):
            try:
                rec = json.loads(data)
            except json.JSONDecodeError:
                continue
            tokens = rec.get("tokens") or {}
            created = (rec.get("time") or {}).get("created")
            if rec.get("role") != "assistant" or not tokens or not created:
                continue
            day = (datetime.datetime.fromtimestamp(created / 1000, tz=datetime.timezone.utc)
                   .astimezone().date().isoformat())
            model = rec.get("modelID") or (rec.get("model") or {}).get("modelID") or "unknown"
            cache = tokens.get("cache") or {}
            bucket = sums[f"{day}\x00{model}"]
            bucket[0] += tokens.get("input") or 0
            bucket[1] += tokens.get("output") or 0
            bucket[2] += cache.get("read") or 0
            bucket[3] += cache.get("write") or 0
    except sqlite3.Error:
        pass
    finally:
        con.close()
    return sums


# --- pricing and row assembly --------------------------------------------------

def litellm_table(online):
    """LITELLM_SNAPSHOT, overridden by a fetched LiteLLM price list when one is
    cached (or `--online` refreshes it). Fetched entries are reduced to the
    same canonical-key, USD-per-1M shape as the snapshot."""
    prices = CACHE_DIR / "litellm.json"
    if online:
        try:
            with urllib.request.urlopen(LITELLM_URL, timeout=30) as resp:
                body = resp.read()
            json.loads(body)  # validate before caching
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            tmp = CACHE_DIR / "litellm.tmp"
            tmp.write_bytes(body)
            os.replace(tmp, prices)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"warning: LiteLLM refresh failed ({exc}); using cached/embedded prices",
                  file=sys.stderr)
    table = dict(LITELLM_SNAPSHOT)
    try:
        full = json.loads(prices.read_text())
    except (OSError, json.JSONDecodeError):
        return table
    for key in table:
        entry = full.get(key)
        if isinstance(entry, dict):
            table[key] = tuple((entry.get(k) or 0) * 1e6 for k in
                               ("input_cost_per_token", "output_cost_per_token",
                                "cache_read_input_token_cost",
                                "cache_creation_input_token_cost"))
    return table


def litellm_rates(model, table):
    """USD-per-1M rate tuple for a model, or None. Exact canonical match, then
    longest prefix (dated snapshots resolve to their family)."""
    key = canon(model)
    if key in table:
        return table[key]
    for name in sorted(table, key=len, reverse=True):
        if key.startswith(name):
            return table[name]
    return None


def token_cost_usd(rates, tokens):
    """Linear list-price cost, LiteLLM style (no rounding)."""
    in_r, out_r, cr_r, cw_r = rates
    return (tokens["inputTokens"] * in_r + tokens["outputTokens"] * out_r
            + tokens["cacheReadTokens"] * cr_r
            + tokens["cacheCreationTokens"] * cw_r) / 1e6


def token_rows(harness_sums, online):
    """Per (day, harness, model) rows from the native scanners' sums.

    The scanners are the token ground truth; this only turns those counts into
    dollars, linearly, from the LiteLLM table. The l3m harness does not come
    through here -- it self-prices from its own cents."""
    table = litellm_table(online)
    rows = []
    for harness, (sums, long_sums) in harness_sums.items():
        unmeasured = UNOBSERVABLE_BUCKETS.get(harness, ())
        for key, tok in sums.items():
            day, model = key.split("\x00")
            tokens = dict(zip(TOKEN_KEYS, tok, strict=True))
            rate = litellm_rates(model, table)
            cost = token_cost_usd(rate, tokens) if rate else 0.0

            long_context = codex_long_rates(model)
            long_tok = long_sums.get(key)
            if rate and long_context and long_tok:
                # Two-stage pricing: the long-context portion was charged at base
                # rates above; swap it to the long-context rates.
                portion = dict(zip(TOKEN_KEYS, long_tok, strict=True))
                cost += (token_cost_usd(long_context[1], portion)
                         - token_cost_usd(rate, portion))

            # A token model that priced to $0 means no table has an entry for it.
            # Named in provenance rather than glued onto the source string as a
            # "!" suffix, so render tests a label instead of parsing one.
            priced_by = UNPRICED if (cost == 0.0 and any(tokens.values())) else "litellm"

            # Consumed is in Mtok so it shares a scale with the $/Mtok rate;
            # the rate is effective (cost / tokens) so Consumed x Rate == Cost.
            mtok = sum(tokens.values()) / 1e6
            rows.append({
                "day": day, "harness": harness, "model": model,
                "consumed": mtok, "unit": "Mtok",
                "rate": (cost / mtok) if mtok else 0.0,
                "cost": cost, "tokens": tokens, "assumed_mix": None,
                "unmeasured": unmeasured,
                "provenance": provenance(
                    consumed=COUNTED, cost=priced_by,
                    mix=PARTIAL if unmeasured else MEASURED),
            })
    return rows


def validate_rows(rows):
    """Assert the cross-field coherence provenance() alone cannot see.

    provenance() checks each label is in the vocabulary; this checks the labels
    agree with the row they describe -- a row with no token buckets claiming a
    MEASURED mix, or a PARTIAL mix with nothing actually unmeasured. Runs on every
    invocation: one pass over a few hundred rows, against a class of error that
    silently mislabels how a dollar figure is known."""
    for row in rows:
        labels, counted = row["provenance"], bool(row["tokens"])
        where = f"{row['harness']}/{row['model']}"
        presence = "present" if counted else "absent"
        if (labels["consumed"] == COUNTED) != counted:
            raise ValueError(f"{where}: consumed={labels['consumed']} but token "
                             f"buckets {presence}")
        if (labels["mix"] in (MEASURED, PARTIAL)) != counted:
            raise ValueError(f"{where}: mix={labels['mix']} but token buckets "
                             f"{presence}")
        if (labels["mix"] == PARTIAL) != bool(row["unmeasured"]):
            raise ValueError(f"{where}: mix={labels['mix']} disagrees with "
                             f"unmeasured={row['unmeasured']!r}")
        if not set(row["unmeasured"]) <= set(TOKEN_KEYS):
            raise ValueError(f"{where}: unmeasured={row['unmeasured']!r} names a "
                             f"bucket outside {TOKEN_KEYS}")
        if (labels["mix"] == ASSUMED) != bool(row["assumed_mix"]):
            raise ValueError(f"{where}: mix={labels['mix']} disagrees with "
                             f"assumed_mix={row['assumed_mix']!r}")
    return rows


def harness_subtotals(rows):
    """Per-harness aggregates as numbers; render only formats them."""
    agg = {}
    for row in rows:
        bucket = agg.setdefault(row["harness"],
                                {"consumed": 0.0, "cost": 0.0, "unit": ""})
        bucket["consumed"] += row["consumed"]
        bucket["cost"] += row["cost"]
        bucket["unit"] = row["unit"]
    for bucket in agg.values():
        # Effective price per unit. Sums only WITHIN a harness: Mtok and credits
        # are not commensurable, so only Cost is comparable across them.
        bucket["rate"] = (bucket["cost"] / bucket["consumed"]
                          if bucket["consumed"] else 0.0)
    return agg


def render(rows, stream=None):
    # Resolved at call time: a `stream=sys.stdout` default binds whatever stdout
    # was at import, so reassigning sys.stdout later would have no effect.
    stream = sys.stdout if stream is None else stream

    def money(value):
        return f"${value:,.2f}"

    def qty(value):
        return f"{value:,.2f}"

    def fmt_rate(value):
        # Significant-figures format so the constant Kiro rate ($0.0747) and the
        # $/Mtok token rates ($0.76 .. $12.8) both read cleanly in one column.
        return "$0" if not value else f"${value:.3g}"

    if not rows:
        print("No usage data found.", file=stream)
        return

    cols = ["Date", "Day Total", "Harness", "Model", "Consumed", "Unit",
            "Rate", "Cost (USD)"]
    aligns = ["<", ">", "<", "<", ">", "<", ">", ">"]

    day_totals = collections.defaultdict(float)
    for row in rows:
        day_totals[row["day"] or "-"] += row["cost"]

    body = []
    for row in sorted(rows, key=lambda r: (r["day"] or "", r["harness"], -r["cost"])):
        # Flag "$0 because no price table lists this model" on the model cell, so
        # the marker sits on the row it applies to.
        model = row["model"] + (" (!)" if row["provenance"]["cost"] == UNPRICED else "")
        day = row["day"] or "-"
        body.append([day, money(day_totals[day]), row["harness"], model,
                     qty(row["consumed"]), row["unit"], fmt_rate(row["rate"]),
                     money(row["cost"])])

    # Subtotals per harness, then the grand total. Consumed sums only within a
    # harness (one unit each); across harnesses only Cost is summable. Only the
    # Kiro subtotal carries the estimate band -- token costs are list-price points.
    subtotals, band = [], {}
    grand = 0.0
    for harness, bucket in sorted(harness_subtotals(rows).items()):
        grand += bucket["cost"]
        subtotals.append(["Subtotal", "", harness, "", qty(bucket["consumed"]),
                          bucket["unit"], fmt_rate(bucket["rate"]),
                          money(bucket["cost"])])
        if harness == "kiro":
            low, high = (bucket["cost"] * b for b in KIRO_BAND)
            band[len(subtotals) - 1] = f"{money(bucket['cost'])} [{low:,.0f}, {high:,.0f}]"
    total = ["TOTAL", "", "", "", "", "", "", money(grand)]

    # Width over everything except the band suffix, which rides the last column
    # (always rightmost) and may overflow it without disturbing the rest.
    sizing = [cols] + body + subtotals + [total]
    widths = [max(len(r[i]) for r in sizing) for i in range(len(cols))]

    def line(cells):
        print("  ".join(f"{cells[i]:{aligns[i]}{widths[i]}}" for i in range(len(cells))),
              file=stream)

    line(cols)
    line(["-" * w for w in widths])
    last_day = None
    for cells in body:
        # Blank the repeated date and its day total so a day reads as one block.
        if cells[0] == last_day:
            cells = ["", "", *cells[2:]]
        else:
            last_day = cells[0]
        line(cells)

    print(file=stream)
    line(["-" * w for w in widths])
    for index, cells in enumerate(subtotals):
        if index in band:
            cells = [*cells[:-1], band[index]]
        line(cells)
    line(["-" * w for w in widths])
    line(total)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--since", help="filter from date (YYYY-MM-DD)")
    parser.add_argument("--until", help="filter until date, inclusive (YYYY-MM-DD)")
    parser.add_argument("--offline", dest="offline", action="store_true", default=True,
                        help="use embedded/cached LiteLLM prices (default)")
    parser.add_argument("--online", dest="offline", action="store_false",
                        help="refresh LiteLLM prices over the network first")
    args = parser.parse_args()

    # No flag bypasses this, so KIRO_DEFAULT_MIX is provably what priced every
    # Kiro row. Edit that constant to change it.
    credit_rate, assumed_mix = KIRO_DEFAULT_RATE, dict(KIRO_DEFAULT_MIX)
    # Threads, not processes: the waits that matter (git subprocesses, sqlite,
    # cold-cache disk I/O) sit outside the GIL, and after the first build the
    # caches leave almost no JSON parsing to serialize. A process pool could not
    # be spawned from a file without a .py suffix anyway.
    with concurrent.futures.ThreadPoolExecutor() as pool:
        futures = {
            "claude": pool.submit(claude_sums),
            "codex": pool.submit(codex_sums),
            "opencode": pool.submit(opencode_sums),
        }
        kiro = pool.submit(kiro_rows, credit_rate, assumed_mix)
        l3m = pool.submit(l3m_rows, l3m_settings())
        harness_sums = {
            "claude": (futures["claude"].result(), {}),
            "codex": futures["codex"].result(),
            "opencode": (futures["opencode"].result(), {}),
        }
        rows = (kiro.result() + l3m.result()
                + token_rows(harness_sums, not args.offline))

    # One date filter for every harness (the scanners run unfiltered so their
    # caches serve every window). Undated rows are kept deliberately -- see the
    # module docstring.
    if args.since:
        rows = [r for r in rows if not r["day"] or r["day"] >= args.since]
    if args.until:
        rows = [r for r in rows if not r["day"] or r["day"] <= args.until]

    validate_rows(rows)

    render(rows)


if __name__ == "__main__":
    main()
