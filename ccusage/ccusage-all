# --- provenance ---------------------------------------------------------------
#
# Every row states how each quantity it reports is KNOWN. render reads these
# labels; it never re-infers provenance from whether a field happens to be set.
#
# `mix` -- where the cache-read/write shares come from:
MEASURED = "measured"     # counted by the harness and read from its own logs
PARTIAL = "partial"       # counted, but one bucket its log cannot report
ASSUMED = "assumed"       # follows from a stated assumption, not observed
# `cost` -- the price source, or that no table lists the model:
UNPRICED = "unpriced"
# `consumed` -- what the quantity is:
COUNTED = "counted"       # summed token buckets
METERED = "metered"       # a scalar the harness computed; no breakdown exists

# Buckets a harness's log cannot report, so a zero there is UNOBSERVABLE rather
# than measured. Codex's token_count events carry only input / cached_input /
# output / reasoning_output / total -- no cache-creation field -- while
# gpt-5.6-sol IS billed for cache writes ($6.25/Mtok, $12.50 long-context). Its
# cache-write share is therefore a floor and its cost a slight underestimate.
# Every other harness reports the field (claude cache_creation_input_tokens,
# opencode cache.write, l3m a_cw/c_cw).
UNOBSERVABLE_BUCKETS = {"codex": ("cacheCreationTokens",)}


def provenance(consumed, cost, mix):
    """Build a row's provenance, rejecting any label outside the vocabulary: a
    typo would otherwise fall through render's lookups and read as measured."""
    labels = {"consumed": consumed, "cost": cost, "mix": mix}
    allowed = {"consumed": {COUNTED, METERED},
               "mix": {MEASURED, PARTIAL, ASSUMED}}
    for key, valid in allowed.items():
        if labels[key] not in valid:
            raise ValueError(f"provenance {key}={labels[key]!r} not in {sorted(valid)}")
    if not cost:
        raise ValueError("provenance cost must name a price source")
    return labels

