# Non-interactive safety net for cp/mv/rm.
# oh-my-zsh's common-aliases plugin sets `cp -i`/`mv -i`/`rm -i`. In a shell with no
# TTY (Claude Code's Bash tool, cron, CI) the overwrite prompt has nothing to answer it,
# so the command HANGS forever (observed: a `cp -i` blocked an agent shell for ~2 days).
# Replace the aliases with functions that keep the interactive `-i` guard ONLY when stdin
# is a terminal and run bare otherwise. Call-time `-t 0` check → correct regardless of how
# the shell snapshot was captured. `command` bypasses the function on the inner call.
for _c in cp mv rm; do unalias $_c 2>/dev/null; done; unset _c
cp() { if [[ -t 0 ]]; then command cp -i "$@"; else command cp "$@"; fi; }
mv() { if [[ -t 0 ]]; then command mv -i "$@"; else command mv "$@"; fi; }
rm() { if [[ -t 0 ]]; then command rm -i "$@"; else command rm "$@"; fi; }
