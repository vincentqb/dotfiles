{
  "chat.defaultAgent": "nitrogen-dev-plus",
  "chat.defaultModel": "claude-fable-5",
  "chat.modelDefaults": {
    "claude-opus-4.8": {
      "output_config": {
        "effort": "max"
      }
    },
    "claude-opus-5": {
      "output_config": {
        "effort": "max"
      }
    },
    "openai-gpt-5.5": {
      "reasoning": {
        "effort": "xhigh"
      }
    },
    "openai-gpt-5.4": {
      "reasoning": {
        "effort": "xhigh"
      }
    },
    "gpt-5.6-sol": {
      "reasoning": {
        "effort": "max"
      }
    },
    "claude-fable-5": {
      "output_config": {
        "effort": "max"
      }
    }
  },
  "chat.showThinking": true,
  "chat.enableThinking": true,
  "mcp.loadedBefore": true,
  "chat.verbosity.tui": {
    "filters": [
      "all",
      "-subagent"
    ],
    "display": {
      "showToolReasoning": false,
      "toolArgsMode": "block",
      "showElapsed": false,
      "subagent": {
        "pipeline": false,
        "prompts": false,
        "roles": false,
        "deps": false,
        "responses": false
      },
      "thinkingDisplay": "collapsed",
      "showThinkingContent": true,
      "showWriteDiffs": true,
      "showTasks": true,
      "persistOutput": false,
      "argsMaxLines": null,
      "outputMaxLines": 5,
      "argsMaxChars": null,
      "outputMaxChars": null
    }
  },
  "chat.enableAutoAgentUpgrade": true
}