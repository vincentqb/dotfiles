# Allowlist. ~/.claude is this directory, and Claude Code writes its live state
# here: transcripts, caches, plugins, history and credentials. Ignore everything,
# then re-include only what we author, so a new state file is ignored by default.
/*
!/.gitignore
!/settings.json
!/settings-byoa.json
!/statusline-command.sh
!/rules/
# Written by managers, not us: the claude-code toolbox wrapper and AIM write the
# *-do-not-delete.md rules, and `arcc setup` writes arcc-governance.md.
/rules/*-do-not-delete.md
/rules/arcc-governance.md
!/hooks/
!/skills
# agents/ is mostly AIM-managed drops. An excluded directory can't be
# re-included, so re-include the directory, then exclude its contents.
!/agents/
/agents/*
!/agents/parallel-writer.md
!/agents/quennv-*
