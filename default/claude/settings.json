    "hard_deny": [
      "$defaults",
      "sudo or any privilege escalation",
      "Piping curl or wget output directly into a shell (curl ... | sh, wget ... | bash)",
      "rm -rf targeting /, $HOME, ~, or with --no-preserve-root",
      "dd writing to block devices, mkfs, shutdown, reboot, halt, poweroff",
