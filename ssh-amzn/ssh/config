Host *
    TcpKeepAlive yes
    ServerAliveInterval 30
    ServerAliveCountMax 6
    ControlMaster auto
    ControlPath ~/.ssh/control:%C

Host ddsk
    Hostname dev-dsk-quennv-1e-5210c771.us-east-1.amazon.com
    User ec2-user
    IdentityFile ~/.ssh/quennv_ec2.pem
    Port 22
    RemoteCommand (tmux new || tmux attach -t 0)
    RequestTTY force

