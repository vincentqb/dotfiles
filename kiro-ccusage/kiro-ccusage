#!/usr/bin/env python3
"""Export Kiro CLI per-turn usage into a JSONL layout ccusage can read.

Kiro meters in *credits*, not tokens — the service returns a pre-computed
scalar and the client never sees token counts. So token columns are 0 and the
cost value goes in `costUSD`, which overrides ccusage's own pricing.

By default that cost is a USD estimate; `--credits` reports the raw credits.
Kiro's per-model `rate_multiplier` (from `kiro-cli chat --list-models`) tracks
each model's Bedrock input price — checked against published prices for models
NOT used to fit it: opus-4.5 within 1.5%, haiku-4.5 within 8%. Since credits
already scale by that multiplier, the multiplier cancels and one
model-independent rate converts credits to dollars. Calibration below.

Source of truth is the v3 session log:
  ~/.kiro/sessions/<workspace-hash>/sess_<uuid>/messages.jsonl
where each completed turn appends {"payload": {"type": "usage_summary", ...}}.

Output layout, which ccusage groups by *path*, not by record fields:
  <out>/projects/<workspace-basename>/<session-uuid>.jsonl

Bare invocation refreshes the export and prints the daily cost estimate, the way
`ccusage` does. `--ccusage` defers to ccusage itself, which shows the same data
plus five structurally-zero token columns; both read the same export, so other
ccusage commands (monthly, session) work against it via CLAUDE_CONFIG_DIR.

Usage:
  kiro-ccusage                  # refresh, then print the daily cost estimate
  kiro-ccusage --credits        # report raw credits instead of dollars
  kiro-ccusage --credit-rate .056  # override the USD-per-credit rate
  kiro-ccusage --quiet          # refresh only, no table
  kiro-ccusage --ccusage        # print ccusage's own table instead
"""

import argparse
import collections
import glob
import json
import os
import pathlib
import subprocess
import sys

KIRO_SESSIONS = pathlib.Path(os.environ.get("KIRO_HOME", "~/.kiro")).expanduser() / "sessions"
DEFAULT_OUT = pathlib.Path("~/.local/share/kiro-ccusage").expanduser()

# USD per credit, derived rather than guessed — run ./calibrate.py to re-derive
# it, and see FINDINGS.md for the full argument. In short: Kiro logs a
# per-request context-fill percentage beside each turn's credits, so on
# single-request turns the billed token count is measurable and credits/token
# solves directly at 1 credit @ multiplier 1.0 = ~317,000 cached-input tokens
# (median of 48 turns, 3 models; held-out opus-4.7 check -0.5%). Kiro's per-model
# rate_multiplier tracks Bedrock input price, and since credits already scale by
# it, the multiplier cancels and one model-independent rate applies.
USD_PER_CREDIT = 0.0747

# Uncertainty on that rate, as multipliers of it, printed next to every cost so
# the estimate is never mistaken for a bill. Two independent error sources compose
# here, and the band spans their corners ($0.0647 to $0.1405):
#
#   1. credits-per-token spread. The calibration sample is bimodal -- some turns
#      cost 1.8x others at identical context, most likely from thinking and output
#      tokens that Kiro bills but never reports. Its p10-to-max range dominates.
#   2. the multiplier-to-Bedrock-price anchor, which varies +/-4.7% across the
#      three models whose list price is public.
#
# Asymmetric (-13%/+88%) because credits-per-token is left-skewed: the median sits
# near p90, so most turns land near the low-cost end with a tail running high.
# A tighter band excluding source 2 put the independent token-priced cross-check
# just outside the interval, by about 1%, which is how that omission surfaced;
# calibrate.py asserts containment. The input/output mix is deliberately NOT
# compounded on top: unreported output tokens are what inflate credits-per-token
# in the first place, so widening for both would double-count one phenomenon.
COST_BAND = (0.0647 / 0.0747, 0.1405 / 0.0747)


def turns(session_dir):
    """Yield (timestamp, execution_id, credits, model) per completed turn.

    Credits arrive on a usage_summary record, but the model that spent them is
    only named on the assistant records sharing its executionId — so collect
    both in one pass and join at the end.
    """
    messages = session_dir / "messages.jsonl"
    if not messages.is_file():
        return
    models = {}
    summaries = []
    with messages.open() as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = record.get("payload") or {}
            execution_id = payload.get("executionId") or record.get("id")

            if payload.get("type") == "assistant" and payload.get("reasoningModelId"):
                # Namespaced as "qdev::claude-opus-5"; keep the bare model name.
                models.setdefault(execution_id, payload["reasoningModelId"].rpartition("::")[2])
                continue

            if payload.get("type") != "usage_summary":
                continue
            credits = sum(
                summary.get("usage", 0)
                for summary in payload.get("promptTurnSummaries") or []
                if str(summary.get("unit", "")).lower().startswith("credit")
            )
            if credits > 0:
                summaries.append((record.get("timestamp"), execution_id, credits))

    for timestamp, execution_id, credits in summaries:
        yield timestamp, execution_id, credits, models.get(execution_id)


def export(out_dir, credit_rate):
    projects = out_dir / "projects"
    projects.mkdir(parents=True, exist_ok=True)
    written = skipped = 0

    for session_dir in sorted(KIRO_SESSIONS.glob("*/sess_*")):
        try:
            meta = json.loads((session_dir / "session.json").read_text())
        except (OSError, json.JSONDecodeError):
            meta = {}

        # session.json names one model for the whole session, which is wrong for
        # a session that switched models; per-turn attribution wins where the
        # join succeeded, and this is only the fallback.
        session_model = meta.get("modelId") or "kiro-unknown"
        workspaces = meta.get("workspacePaths") or []
        project = pathlib.Path(workspaces[0]).name if workspaces else "unknown"
        session_id = session_dir.name.removeprefix("sess_")

        records = []
        for timestamp, execution_id, credits, model in turns(session_dir):
            if not timestamp or not execution_id:
                skipped += 1
                continue
            model = model or session_model
            records.append(
                {
                    "type": "assistant",
                    "timestamp": timestamp,
                    "costUSD": round(credits * credit_rate, 6),
                    # Credits are what Kiro actually recorded; the dollar figure
                    # above is derived from them. Keep them verbatim so the
                    # measurement survives independently of the rate in force,
                    # and so re-pricing never has to touch the source logs.
                    # ccusage ignores unknown top-level fields.
                    "kiroCredits": credits,
                    "message": {
                        # ccusage dedups globally on message.id, and executionId
                        # is stable across re-runs, so re-exporting is a no-op.
                        "id": f"kiro-{execution_id}",
                        "model": model,
                        "usage": {"input_tokens": 0, "output_tokens": 0},
                    },
                }
            )

        if not records:
            continue
        target = projects / project
        target.mkdir(parents=True, exist_ok=True)
        with (target / f"{session_id}.jsonl").open("w") as fh:
            for record in records:
                # Compact separators are required, not cosmetic: ccusage
                # prefilters candidate lines on the literal `"usage":{"`, so a
                # record written with json.dumps' default spacing is skipped.
                fh.write(json.dumps(record, separators=(",", ":")) + "\n")
        written += len(records)

    return written, skipped


def daily_totals(out_dir):
    """Aggregate the export by date and model, mirroring ccusage's grouping."""
    days = collections.defaultdict(
        lambda: {"cost": 0.0, "credits": 0.0, "models": collections.Counter()}
    )
    for path in glob.glob(str(out_dir / "projects/*/*.jsonl")):
        with open(path) as handle:
            for line in handle:
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                day = days[record["timestamp"][:10]]
                day["cost"] += record.get("costUSD", 0.0)
                day["credits"] += record.get("kiroCredits", 0.0)
                day["models"][record["message"]["model"]] += record.get("kiroCredits", 0.0)
    return dict(sorted(days.items()))


def render(out_dir, credit_rate, stream=sys.stdout):
    """Print a ccusage-style table in the units we actually have.

    ccusage's own table is the model here, but it prints five token columns that
    are structurally zero for Kiro plus a "Token Usage Report" title, which
    misrepresents what was measured. Same box-drawing, same right-aligned
    numerics and thousands separators, honest columns.
    """
    days = daily_totals(out_dir)
    dollars = credit_rate != 1.0
    # Credits are the measurement; the dollar column is derived from them. Both
    # are shown when pricing is on so the recorded figure stays visible.
    columns = ["Credits"] + (["Est. Cost (USD)"] if dollars else [])
    # ccusage prints its title in a rounded box, padded three spaces each side.
    title = f"Kiro CLI {'Credit Usage & Cost Estimate' if dollars else 'Credit Usage'} Report - Daily"
    print(f"╭─{'─' * (len(title) + 4)}─╮", file=stream)
    print(f"│ {' ' * (len(title) + 4)} │", file=stream)
    print(f"│   {title}   │", file=stream)
    print(f"│ {' ' * (len(title) + 4)} │", file=stream)
    print(f"╰─{'─' * (len(title) + 4)}─╯", file=stream)
    print(file=stream)

    if not days:
        print("No usage data found.", file=stream)
        return

    def credit(value):
        return f"{value:,.2f}"

    def cost(value):
        """Format a cost with its interval, e.g. "$75 [65, 140]".

        The interval rides on every figure rather than sitting in a footnote, so
        a number lifted out of this table carries its own precision. Rounded to
        whole dollars: cents would imply a precision the estimate does not have.
        """
        low, high = (value * bound for bound in COST_BAND)
        # Anything under a dollar rounds to "$0 [0, 0]", which says nothing; the
        # credits column carries the detail for those rows.
        if high < 1:
            return "<$1"
        return f"${value:,.0f} [{low:,.0f}, {high:,.0f}]"

    models = sorted({model for day in days.values() for model in day["models"]})
    total_credits = sum(day["credits"] for day in days.values())
    total_cost = sum(day["cost"] for day in days.values())

    # Model names are listed one per line under a shared date, as ccusage does.
    widths = [
        max(len("Date"), 10),
        max([len("Models")] + [len(name) + 2 for name in models]),
        max([len("Share")] + [len(credit(value)) for day in days.values()
                              for value in day["models"].values()]) + 1,
        max([len("Credits")] + [len(credit(day["credits"])) for day in days.values()]
            + [len(credit(total_credits))]),
    ]
    if dollars:
        widths.append(max([len(columns[-1])] + [len(cost(day["cost"])) for day in days.values()]
                          + [len(cost(total_cost))]))

    def rule(left, mid, right):
        print(left + mid.join("─" * (width + 2) for width in widths) + right, file=stream)

    def row(cells):
        aligned = [f"{cells[0]:<{widths[0]}}", f"{cells[1]:<{widths[1]}}"]
        aligned += [f"{text:>{width}}" for text, width in zip(cells[2:], widths[2:])]
        print("│ " + " │ ".join(aligned) + " │", file=stream)

    rule("┌", "┬", "┐")
    row(["Date", "Models", "Share"] + columns)
    rule("├", "┼", "┤")
    for date, day in days.items():
        # First model shares the date's row; the rest continue underneath.
        for index, (model, model_credits) in enumerate(day["models"].most_common()):
            totals = [credit(day["credits"])] + ([cost(day["cost"])] if dollars else [])
            row([date, f"- {model}", credit(model_credits)] + totals if index == 0
                else ["", f"- {model}", credit(model_credits)] + [""] * len(totals))
        rule("├", "┼", "┤")
    row(["Total", "", "", credit(total_credits)] + ([cost(total_cost)] if dollars else []))
    rule("└", "┴", "┘")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=pathlib.Path, default=DEFAULT_OUT, help="export root (default: %(default)s)")
    parser.add_argument("--credits", action="store_true", help="report raw credits instead of a cost estimate")
    parser.add_argument(
        "--credit-rate",
        type=float,
        help=f"override USD per credit (default {USD_PER_CREDIT}); 1.0 is equivalent to --credits",
    )
    parser.add_argument("-q", "--quiet", action="store_true", help="refresh the export without printing the table")
    parser.add_argument(
        "--ccusage",
        action="store_true",
        help="print ccusage's own table instead (adds five structurally-zero token columns)",
    )
    args = parser.parse_args()

    if not KIRO_SESSIONS.is_dir():
        sys.exit(f"no Kiro sessions at {KIRO_SESSIONS}")

    if args.credit_rate is not None:
        credit_rate = args.credit_rate
    elif args.credits:
        credit_rate = 1.0
    else:
        credit_rate = USD_PER_CREDIT

    written, skipped = export(args.out, credit_rate)
    if skipped:
        print(f"skipped {skipped} turns missing a timestamp or execution id", file=sys.stderr)
    if args.quiet:
        unit = "credits" if credit_rate == 1.0 else f"estimated USD at ${credit_rate}/credit"
        print(f"exported {written} turns to {args.out}/projects (cost column is in {unit})", file=sys.stderr)

    if args.quiet:
        return
    if args.ccusage:
        os.environ["CLAUDE_CONFIG_DIR"] = str(args.out)
        raise SystemExit(subprocess.call(["ccusage", "claude", "daily"]))
    render(args.out, credit_rate)


if __name__ == "__main__":
    main()
